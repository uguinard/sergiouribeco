---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPortfolio = await getCollection('portfolio');
const sortedPortfolio = allPortfolio.sort((a, b) => a.data.order - b.data.order);

const allArticles = await getCollection('articles', ({ data }) => data.status === 'published');
const sortedArticles = allArticles.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout 
  title="Sergio Uribe — IB-Certified Language Educator & Curriculum Designer"
  description="Integrating 4E cognition and natural induction methodologies into the IB framework. Specialized in Spanish, English, and French language acquisition."
>
  <!-- A. HERO SECTION -->
  <section class="hero-section">
    <div class="container">
      <div class="hero-content">
        <div class="hero-badge-wrapper">
          <span class="badge">
            <span class="badge-pulse-dot"></span>
            IB-Certified Language Educator
          </span>
        </div>

        <h1 class="hero-headline">
          Fostering global citizenship through <span class="headline-gradient">inquiry-driven</span> language acquisition.
        </h1>

        <!-- Capabilities Banner -->
        <div class="capabilities-card glass-card">
          <div class="cap-header">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="cap-icon"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
            <span class="cap-title">Language Continuum & Curricular Scope</span>
          </div>
          <div class="cap-pills">
            <div class="cap-pill">
              <span class="cap-lang">Spanish</span>
              <span class="cap-level">All Levels (MYP & DP)</span>
            </div>
            <div class="cap-divider"></div>
            <div class="cap-pill">
              <span class="cap-lang">English</span>
              <span class="cap-level">Middle School & Primary</span>
            </div>
            <div class="cap-divider"></div>
            <div class="cap-pill">
              <span class="cap-lang">French</span>
              <span class="cap-level">Primary Acquisition</span>
            </div>
          </div>
        </div>

        <p class="hero-subheadline">
          Integrating <strong>4E cognition</strong> and <strong>natural induction methodologies</strong> into the International Baccalaureate framework. I build immersive, cross-curricular language environments that empower students to take genuine ownership of their learning.
        </p>

        <div class="hero-cta-group">
          <a href="#portfolio" class="btn btn-primary">
            View Teaching Portfolio
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>
          <a href="#materials" class="btn btn-secondary">
            Explore Curriculum Design
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- B. FEATURED IB EXPERIENCE & PORTFOLIO GRID -->
  <section id="portfolio" class="section portfolio-section">
    <div class="container">
      <div class="section-header">
        <span class="badge mb-2">Track Record</span>
        <h2 class="section-title">Featured IB Experience & Portfolio</h2>
        <p class="section-subtitle">Leadership, classroom teaching, and institutional curriculum accreditation.</p>
      </div>

      <div class="portfolio-grid">
        {sortedPortfolio.map(item => (
          <article class="portfolio-card glass-card">
            <div class="card-top">
              <span class="badge card-category">{item.data.category}</span>
              <span class="card-period">{item.data.period}</span>
            </div>

            <h3 class="card-title">{item.data.title}</h3>
            <p class="card-org">{item.data.organization} <span class="bullet-dot">•</span> <span class="role-text">{item.data.role}</span></p>
            <p class="card-summary">{item.data.summary}</p>

            {item.data.highlights && (
              <ul class="card-highlights">
                {item.data.highlights.map(h => (
                  <li>
                    <svg class="check-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    <span>{h}</span>
                  </li>
                ))}
              </ul>
            )}

            <div class="card-tags">
              {item.data.tags.map(tag => (
                <span class="tag-pill">{tag}</span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- C. EDUCATIONAL INSIGHTS FEED -->
  <section id="insights" class="section insights-section">
    <div class="container">
      <div class="section-header">
        <span class="badge mb-2">Academic Research</span>
        <h2 class="section-title">Educational Insights & Research</h2>
        <p class="section-subtitle">Explorations in 4E enactivism, natural language induction, and IB pedagogical alignment.</p>
      </div>

      <div class="insights-feed">
        {sortedArticles.map(article => (
          <article class="insight-card glass-card">
            <div class="insight-header">
              <div class="insight-meta">
                <time datetime={article.data.date.toISOString()}>
                  {article.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
                {article.data.readTime && <span class="read-time">• {article.data.readTime}</span>}
              </div>

              <h3 class="insight-title">
                <a href={`/articles/${article.slug}`}>{article.data.title}</a>
              </h3>
            </div>

            <p class="insight-desc">{article.data.description}</p>
            
            <div class="insight-footer">
              <div class="insight-tags">
                {article.data.tags.map(t => (
                  <span class="tag-pill tag-pill-accent">{t}</span>
                ))}
              </div>
              <a href={`/articles/${article.slug}`} class="read-more-link">
                Read Paper
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- D. INTERACTIVE MATERIALS LIBRARY -->
  <section id="materials" class="section materials-section">
    <div class="container">
      <div class="section-header">
        <span class="badge mb-2">Classroom Assets</span>
        <h2 class="section-title">Interactive Materials & Pedagogical Assets</h2>
        <p class="section-subtitle">Tangible classroom tools designed for active comprehensible input and multimodal acquisition.</p>
      </div>

      <div class="materials-grid">
        <div class="material-card glass-card">
          <div class="material-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          </div>
          <h3 class="material-title">TPR Visual Cards & Action Prompts</h3>
          <p class="material-desc">
            Embodied action cards pairing physical movement with target high-frequency structures in Spanish & French.
          </p>
          <div class="material-footer">
            <span class="badge">Visual & Physical</span>
            <span class="action-btn">Preview Cards</span>
          </div>
        </div>

        <div class="material-card glass-card">
          <div class="material-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline></svg>
          </div>
          <h3 class="material-title">H5P Interactive Modules</h3>
          <p class="material-desc">
            Self-correcting interactive audio-visual stories for primary and middle school inquiry units.
          </p>
          <div class="material-footer">
            <span class="badge">Interactive Web</span>
            <span class="action-btn">Launch Demo</span>
          </div>
        </div>

        <div class="material-card glass-card">
          <div class="material-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
          </div>
          <h3 class="material-title">Inductive Learning Stories</h3>
          <p class="material-desc">
            Rich storytelling texts engineered for implicit grammar discovery and student-led inquiry.
          </p>
          <div class="material-footer">
            <span class="badge">Curriculum Assets</span>
            <span class="action-btn">Read Sample</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 6rem 0 5rem;
    position: relative;
  }

  .hero-content {
    max-width: 56rem;
  }

  .hero-badge-wrapper {
    margin-bottom: 1.5rem;
  }

  .hero-headline {
    font-size: clamp(2.5rem, 4.5vw + 1rem, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    margin-bottom: 2rem;
    line-height: 1.12;
  }

  .headline-gradient {
    background: linear-gradient(135deg, var(--accent) 0%, #d97706 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Capabilities Glass Card */
  .capabilities-card {
    padding: 1.25rem 1.5rem;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cap-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .cap-pills {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem;
  }

  .cap-pill {
    display: flex;
    flex-direction: column;
  }

  .cap-lang {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cap-level {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cap-divider {
    width: 1px;
    height: 2rem;
    background-color: var(--border-color);
    display: none;
  }

  @media (min-width: 640px) {
    .cap-divider {
      display: block;
    }
  }

  .hero-subheadline {
    font-size: 1.2rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2.5rem;
    max-width: 50rem;
  }

  .hero-subheadline strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  .hero-cta-group {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  /* Section Styles */
  .section {
    padding: 6rem 0;
    position: relative;
  }

  .section-header {
    margin-bottom: 3.5rem;
  }

  .section-title {
    font-size: 2.25rem;
    font-weight: 700;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
  }

  /* Portfolio Grid */
  .portfolio-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .portfolio-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .portfolio-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .card-period {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-muted);
    font-family: var(--font-mono);
  }

  .card-title {
    font-size: 1.35rem;
    font-weight: 700;
    margin-bottom: 0.35rem;
  }

  .card-org {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .bullet-dot {
    color: var(--border-focus);
  }

  .role-text {
    color: var(--accent);
    font-weight: 600;
  }

  .card-summary {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    line-height: 1.55;
  }

  .card-highlights {
    list-style: none;
    margin-bottom: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .card-highlights li {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  .check-icon {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px dashed var(--border-color);
  }

  .tag-pill {
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
    background-color: var(--badge-bg);
    color: var(--badge-text);
    border: 1px solid var(--badge-border);
  }

  .tag-pill-accent {
    background-color: var(--accent-light);
    color: var(--accent);
    border-color: transparent;
  }

  /* Insights Feed */
  .insights-feed {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .insight-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .insight-meta {
    font-size: 0.825rem;
    font-weight: 600;
    color: var(--text-muted);
    font-family: var(--font-mono);
    margin-bottom: 0.5rem;
  }

  .insight-title {
    font-size: 1.5rem;
  }

  .insight-title a {
    color: var(--text-primary);
    text-decoration: none;
  }

  .insight-title a:hover {
    color: var(--accent);
  }

  .insight-desc {
    font-size: 1rem;
    color: var(--text-secondary);
  }

  .insight-footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .read-more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--accent);
  }

  .read-more-link:hover {
    gap: 0.6rem;
  }

  /* Materials Grid */
  .materials-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media (min-width: 768px) {
    .materials-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .material-card {
    padding: 2.25rem 2rem;
    display: flex;
    flex-direction: column;
  }

  .material-icon {
    width: 3.25rem;
    height: 3.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-light) 0%, var(--badge-bg) 100%);
    color: var(--accent);
    border-radius: var(--radius-lg);
    border: 1px solid var(--badge-border);
    margin-bottom: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .material-title {
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
  }

  .material-desc {
    font-size: 0.925rem;
    color: var(--text-secondary);
    margin-bottom: 1.75rem;
    line-height: 1.55;
  }

  .material-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
  }

  .action-btn {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--accent);
    cursor: pointer;
    transition: var(--transition-smooth);
  }

  .material-card:hover .action-btn {
    color: var(--accent-hover);
    transform: translateX(2px);
  }
</style>
