{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "pubDate": {
      "type": "string",
      "format": "date-time"
    },
    "category": {
      "default": "General",
      "type": "string"
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thumbnail": {
      "type": "string"
    },
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "related_concepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sensory_modality": {
      "type": "string",
      "enum": [
        "visual",
        "auditory",
        "textual",
        "interactive"
      ]
    },
    "audio_asset": {
      "type": "string"
    },
    "visual_asset": {
      "type": "string"
    },
    "affective_state": {
      "type": "string",
      "enum": [
        "grounding",
        "disruptive",
        "expansive",
        "reflective",
        "kinetic"
      ]
    },
    "emotional_resonance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "conceptual_metaphors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "affordances": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "pubDate"
  ]
}