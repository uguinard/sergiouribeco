---
import '../styles/global.css';
import { ui } from '../i18n/ui';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  isDarkroom?: boolean;
}

const { 
  title, 
  description = 'Ecosistema Digital de Sergio Uribe', 
  lang = 'en',
  isDarkroom = false
} = Astro.props;
const t = ui[lang];
const pathname = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | Sergio Uribe</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Albert+Sans:wght@400;700&family=Lora:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
    <ClientRouter />
  </head>
  <body class={`min-h-screen selection:bg-earth selection:text-paper antialiased ${isDarkroom ? "darkroom bg-neutral-950 text-neutral-100" : "text-ink bg-sand font-serif"}`}>
    {!isDarkroom && (
      <header id="site-header" class="fixed w-full top-0 z-50 py-4 md:py-6 transition-all duration-300 border-b border-transparent bg-transparent">
        <nav class="max-w-5xl mx-auto px-4 md:px-6 flex justify-between items-center font-sans text-xs md:text-sm tracking-widest text-ink-light uppercase">
          <a href={`/${lang === 'en' ? '' : lang}`} class="hover:text-clay transition-colors duration-300 font-medium tracking-[0.2em] text-ink">
            {t['nav.name']}
          </a>

          <!-- Mobile Menu Toggle -->
          <button id="menu-toggle" class="z-[60] md:hidden flex flex-col gap-1.5 p-2 focus:outline-none" aria-label="Toggle Menu">
            <span class="w-5 h-[1px] bg-ink transition-all duration-300 origin-center"></span>
            <span class="w-5 h-[1px] bg-ink transition-all duration-300"></span>
            <span class="w-5 h-[1px] bg-ink transition-all duration-300 origin-center"></span>
          </button>

          <!-- Navigation Menu -->
          <div id="nav-menu" class="fixed inset-0 bg-sand/98 backdrop-blur-xl z-50 flex flex-col justify-center items-center gap-10 translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:static md:flex-row md:translate-x-0 md:bg-transparent md:backdrop-blur-none md:p-0 md:border-none md:gap-8">
            <a href={`/${lang === 'en' ? '' : lang + '/'}philosophy`} class={`nav-item ${pathname.includes('/philosophy') ? 'active' : ''}`}>{t['nav.philosophy']}</a>
            <a href={`/${lang === 'en' ? '' : lang + '/'}cv`} class={`nav-item ${pathname.includes('/cv') ? 'active' : ''}`}>{t['nav.cv']}</a>
            <a href={`/${lang === 'en' ? '' : lang + '/'}posts`} class={`nav-item ${pathname.includes('/posts') ? 'active' : ''}`}>{t['nav.posts']}</a>
            <div class="h-3 w-[1px] bg-ink/10 mx-1 hidden md:block"></div>
            <a href={lang === 'en' ? `/es${Astro.url.pathname}` : Astro.url.pathname.replace(/^\/es/, '') || '/'} class="hover:text-clay transition-colors duration-300 text-earth font-medium">
              {lang === 'en' ? 'ES' : 'EN'}
            </a>
          </div>
        </nav>
      </header>
    )}

    <div class={isDarkroom ? "w-full min-h-screen" : "page-content pt-28 md:pt-32"}>
      <main class={isDarkroom ? "" : "animate-fade-in-up"}>
        <slot />
      </main>
    </div>
      {!isDarkroom && (
        <footer class="mt-32 pt-12 border-t border-earth/20 font-sans text-xs text-ink-light flex flex-col md:flex-row justify-between gap-4">
          <p>{t['footer.rights']}</p>
          <p>{t['footer.motto']}</p>
        </footer>
      )}
    {isDarkroom && (
      <script is:inline>
        (function() {
          if (window.__snapshotKeyHandler) {
            document.removeEventListener('keydown', window.__snapshotKeyHandler, true);
          }

          window.__snapshotKeyHandler = function(e) {
            var main = document.querySelector('[data-next-slug]');
            if (!main) return;
            var next = main.getAttribute('data-next-slug');
            var prev = main.getAttribute('data-prev-slug');
            var lang = main.getAttribute('data-lang');
            var prefix = lang === 'es' ? '/es' : '';

            if (e.key === 'ArrowDown' && next) { e.preventDefault(); window.location.href = prefix + '/snapshots/' + next; return; }
            if (e.key === 'ArrowUp'   && prev) { e.preventDefault(); window.location.href = prefix + '/snapshots/' + prev; return; }
            if (e.key === 'Escape')            { e.preventDefault(); window.location.href = prefix + '/snapshots'; }
          };

          document.addEventListener('keydown', window.__snapshotKeyHandler, true);
        })();
      </script>
    )}
    <script>
      // ── Scroll position save/restore for snapshots index ────────────
      (function() {
        function maybeRestoreScroll() {
          var path = window.location.pathname;
          var isSnapshotsIndex = path === '/snapshots' || path === '/es/snapshots'
            || path === '/snapshots/' || path === '/es/snapshots/';
          if (!isSnapshotsIndex) return;
          var saved = sessionStorage.getItem('snapshotsScrollY');
          if (!saved) return;
          requestAnimationFrame(function() {
            requestAnimationFrame(function() {
              window.scrollTo(0, parseInt(saved, 10));
              sessionStorage.removeItem('snapshotsScrollY');
            });
          });
        }

        // On first load
        maybeRestoreScroll();

        // After every View Transition
        document.addEventListener('astro:after-swap', maybeRestoreScroll);

        // Save scroll when clicking into a snapshot entry
        document.addEventListener('click', function(e) {
          var a = e.target.closest('a[href]');
          if (!a) return;
          var href = a.getAttribute('href') || '';
          if (href.match(/\/snapshots\/[^/]+/)) {
            sessionStorage.setItem('snapshotsScrollY', String(window.scrollY));
          }
        });
      })();

      // ── Scroll-linked Header state ──────────────────────────────────
      function initHeaderScroll() {
        const header = document.getElementById('site-header');
        if (!header) return;
        
        function handleScroll() {
          if (window.scrollY > 20) {
            header.classList.add('bg-sand/90', 'backdrop-blur-md', 'border-earth/10', 'shadow-sm');
            header.classList.remove('bg-transparent', 'border-transparent');
          } else {
            header.classList.remove('bg-sand/90', 'backdrop-blur-md', 'border-earth/10', 'shadow-sm');
            header.classList.add('bg-transparent', 'border-transparent');
          }
        }
        
        window.addEventListener('scroll', handleScroll);
        handleScroll(); // Run once on load
      }
      document.addEventListener('astro:page-load', initHeaderScroll);

      // ── Mobile menu ──────────────────────────────────────────────────
      document.addEventListener('astro:page-load', () => {
        const menuToggle = document.getElementById('menu-toggle');
        const navMenu = document.getElementById('nav-menu');
        const spans = menuToggle?.querySelectorAll('span');

        if (!menuToggle || !navMenu || !spans) return;

        function closeMenu() {
          navMenu.classList.add('translate-x-full');
          document.body.classList.remove('overflow-hidden');
          spans[0].setAttribute('style', '');
          spans[1].setAttribute('style', '');
          spans[2].setAttribute('style', '');
        }

        menuToggle.addEventListener('click', () => {
          const isExpanded = !navMenu.classList.contains('translate-x-full');

          // Toggle the sliding drawer
          navMenu.classList.toggle('translate-x-full');

          // Lock/unlock body scroll
          document.body.classList.toggle('overflow-hidden');

          // Animate the hamburger icon
          if (!isExpanded) {
            spans[0].setAttribute('style', 'transform: translateY(7px) rotate(45deg);');
            spans[1].setAttribute('style', 'opacity: 0;');
            spans[2].setAttribute('style', 'transform: translateY(-7px) rotate(-45deg);');
          } else {
            spans[0].setAttribute('style', '');
            spans[1].setAttribute('style', '');
            spans[2].setAttribute('style', '');
          }
        });

        // Close drawer when clicking a link inside it
        navMenu.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', closeMenu);
        });
      });
    </script>
  </body>
</html>

<style is:global>
  /* Navigation & Labels */
  .nav-item, .eyebrow, .about-label, .cta-btn {
    font-family: var(--font-body);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  /* Navigation Item Soft Underline */
  .nav-item {
    position: relative;
    padding: 0.2rem 0;
    color: var(--color-ink-light);
    transition: color 0.3s ease;
    text-decoration: none;
    font-size: 0.75rem;
  }
  .nav-item::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 1px;
    background-color: var(--color-clay);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    transform: translateX(-50%);
    opacity: 0;
  }
  .nav-item:hover {
    color: var(--color-ink);
  }
  .nav-item:hover::after {
    width: 100%;
    opacity: 1;
  }
  .nav-item.active {
    color: var(--color-ink);
  }
  .nav-item.active::after {
    width: 100%;
    opacity: 1;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
  }

  /* Transition for mobile menu interaction */
  #nav-menu {
    transition: all 0.3s ease-in-out;
  }
</style>
