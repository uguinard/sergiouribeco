---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';

const allPosts = await getCollection('posts_es', ({ data }) => 
  import.meta.env.PROD ? data.draft !== true : true
);

// Sort posts by pubDate desc
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get all unique categories
const categories = Array.from(new Set(allPosts.map(p => p.data.category)));
const allTags = Array.from(new Set(allPosts.flatMap(p => p.data.tags)));
---

<Layout title="Artículos" lang="es">
  <div class="max-w-4xl mx-auto mt-12 px-4 md:px-6">
    <div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-b border-earth/10 pb-8">
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-ink tracking-tight mb-3 font-light">Artículos y Reflexiones</h1>
        <p class="font-serif text-lg text-ink-soft italic leading-relaxed max-w-2xl">
          Escritos sobre la enacción del lenguaje, la cognición 4E y la seguridad relacional en aulas internacionales.
        </p>
      </div>
      <!-- Layout Switcher Toggle -->
      <div class="flex items-center gap-1.5 bg-paper/50 border border-earth/15 p-1 rounded-xl shadow-sm self-stretch md:self-auto justify-center">
        <button 
          id="layout-split-btn"
          class="flex items-center gap-2 px-4 py-2 text-xs font-sans font-medium rounded-lg text-clay bg-clay/10 transition-all duration-300"
          aria-label="Cambiar a diseño dividido"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          Dividido
        </button>
        <button 
          id="layout-instagram-btn"
          class="flex items-center gap-2 px-4 py-2 text-xs font-sans font-medium rounded-lg text-earth hover:text-clay hover:bg-paper/85 transition-all duration-300"
          aria-label="Cambiar a cuadrícula tipo Instagram"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
          Instagram
        </button>
      </div>
    </div>

    <!-- Filter and Search Header (Aside) -->
    <aside class="mb-8 p-6 rounded-2xl border border-earth/10 bg-paper/30 space-y-6">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 items-start">
        <!-- Search Input -->
        <div class="space-y-2">
          <label for="post-search" class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase block">Buscar</label>
          <div class="relative">
            <input 
              type="text" 
              id="post-search" 
              placeholder="Buscar artículos..." 
              class="w-full px-4 py-2 text-sm font-sans rounded-xl bg-paper/50 border border-earth/15 text-ink placeholder:text-ink/40 focus:outline-none focus:border-clay/60 transition-colors duration-300"
            />
          </div>
        </div>

        <!-- Categories Filter -->
        {categories.length > 0 && (
          <div class="space-y-2 md:col-span-2">
            <p class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase">Categorías</p>
            <div class="flex flex-wrap gap-2">
              <button 
                data-category-btn="all"
                class="category-btn active px-3 py-1.5 rounded-lg text-xs font-sans font-medium bg-clay/10 text-clay transition-all duration-300 hover:bg-clay/15"
              >
                Todas las categorías
              </button>
              {categories.map(cat => (
                <button 
                  data-category-btn={cat}
                  class="category-btn px-3 py-1.5 rounded-lg text-xs font-sans text-earth hover:text-clay hover:bg-paper/50 transition-all duration-300"
                >
                  {cat}
                </button>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Tags Cloud -->
      {allTags.length > 0 && (
        <div class="space-y-2 pt-4 border-t border-earth/10">
          <p class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase">Etiquetas populares</p>
          <div class="flex flex-wrap gap-1.5">
            {allTags.map(tag => (
              <button 
                data-tag-btn={tag}
                class="tag-btn text-xs font-sans px-2.5 py-1 bg-paper/30 hover:bg-paper/60 border border-earth/10 text-earth-soft hover:text-clay hover:border-clay rounded-md transition-all duration-300"
              >
                #{tag}
              </button>
            ))}
          </div>
        </div>
      )}
    </aside>

    <div class="relative">
      <!-- Main Content: Articles Container -->
      <div class="space-y-6">
        <div id="posts-container" class="space-y-6">
          {allPosts.length === 0 ? (
            <div class="p-8 text-center border border-dashed border-earth/25 rounded-2xl">
              <p class="font-serif text-ink-soft italic">No se encontraron artículos.</p>
            </div>
          ) : (
            <ul id="posts-list" class="flex flex-col gap-8 p-0 m-0 list-none transition-all duration-300">
              {allPosts.map(post => {
                const formattedDate = post.data.pubDate.toLocaleDateString('es-ES', { 
                  month: 'short', day: 'numeric', year: 'numeric' 
                });
                const isoDate = post.data.pubDate.toISOString();

                return (
                  <li 
                    data-post-card
                    data-title={post.data.title.toLowerCase()}
                    data-desc={(post.data.description || '').toLowerCase()}
                    data-category={post.data.category}
                    data-tags={JSON.stringify(post.data.tags)}
                    class="group relative overflow-hidden rounded-2xl border border-earth/10 bg-paper/35 hover:bg-paper/70 hover:shadow-md hover:border-earth/20 transition-all duration-300 flex flex-col md:flex-row min-h-[220px]"
                  >
                    <!-- Image Area -->
                    {post.data.thumbnail ? (
                      <a href={`/es/posts/${post.id}`} class="post-img-wrapper block w-full md:w-[35%] shrink-0 h-48 md:aspect-[4/3] overflow-hidden relative z-20">
                        <Image 
                          src={post.data.thumbnail} 
                          alt={post.data.title} 
                          class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform"
                          width={600}
                          height={600}
                          sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    ) : (
                      <div class="post-img-wrapper block w-full md:w-[35%] shrink-0 h-48 md:aspect-[4/3] overflow-hidden relative z-20 bg-gradient-to-br from-earth/15 to-clay/15 transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform"></div>
                    )}

                    <!-- Top overlay overlay gradient (Instagram mode only) -->
                    <div class="instagram-scrim absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent opacity-0 pointer-events-none transition-opacity duration-300 z-10"></div>

                    <!-- Floating header container (h-aligned category & date, dynamic positioning) -->
                    <div class="instagram-header hidden absolute top-4 inset-x-4 z-10 flex justify-between items-start p-0">
                      <span class="inline-flex items-center rounded-full bg-clay/5 text-clay border border-clay/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all duration-300">
                        {post.data.category}
                      </span>
                      <time datetime={isoDate} class="post-time-element text-xs font-sans text-ink-soft/60 tracking-wider transition-all duration-300">
                        {formattedDate}
                      </time>
                    </div>

                    <!-- Content body area -->
                    <div class="post-body-container flex-1 p-5 md:p-6 flex flex-col justify-start z-10">
                      <div>
                        <!-- Header container inside body (Split mode) -->
                        <div class="split-header flex justify-between items-center mb-3">
                          <span class="inline-flex items-center rounded-full bg-clay/5 text-clay border border-clay/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider shadow-sm transition-all duration-300">
                            {post.data.category}
                          </span>
                          <time datetime={isoDate} class="post-time-element text-xs font-sans text-ink-soft/60 tracking-wider transition-all duration-300">
                            {formattedDate}
                          </time>
                        </div>

                        <h2 class="post-title-heading font-serif text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20">
                          <a href={`/es/posts/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                            {post.data.title}
                          </a>
                        </h2>

                        <!-- Expandable layout helper wrapper -->
                        <div class="instagram-expand-wrapper transition-all duration-300 ease-in-out">
                          <div class="instagram-opacity-wrapper transition-opacity duration-300">
                            {post.data.description && (
                              <p class="post-desc-p font-sans text-sm text-ink-soft leading-relaxed text-justify line-clamp-3">
                                {post.data.description}
                              </p>
                            )}

                            {post.data.tags.length > 0 && (
                              <div class="post-tags-container flex flex-wrap gap-2 pt-3 mt-3 border-t border-earth/5 relative z-20">
                                {post.data.tags.map(tag => (
                                  <span class="post-tag-item text-[10px] font-sans text-earth/70 transition-all duration-300">#{tag}</span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      </div>
                    </div>
                  </li>
                );
              })}
            </ul>
          )}
          <!-- Empty State (js controlled) -->
          <div id="posts-empty" class="hidden p-12 text-center border border-dashed border-earth/20 rounded-2xl">
            <span class="text-2xl mb-2 block">🔍</span>
            <p class="font-serif text-ink-soft italic">No hay artículos que coincidan con los parámetros de búsqueda.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initFiltersAndLayouts() {
    const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
    const catBtns = document.querySelectorAll('[data-category-btn]');
    const tagBtns = document.querySelectorAll('[data-tag-btn]');
    const cards = document.querySelectorAll('[data-post-card]');
    const emptyState = document.getElementById('posts-empty');

    const postsList = document.getElementById('posts-list');
    const splitBtn = document.getElementById('layout-split-btn');
    const instagramBtn = document.getElementById('layout-instagram-btn');

    let activeCategory = 'all';
    let activeTag: string | null = null;
    let searchQuery = '';
    let currentLayout = localStorage.getItem('posts-layout') || 'split';

    // Layout applicator function
    function applyLayout(layout: string) {
      if (!postsList) return;
      currentLayout = layout;
      localStorage.setItem('posts-layout', layout);

      const items = postsList.querySelectorAll('li');

      if (layout === 'instagram') {
        // Toggle buttons active classes
        splitBtn?.classList.remove('text-clay', 'bg-clay/10');
        splitBtn?.classList.add('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
        instagramBtn?.classList.add('text-clay', 'bg-clay/10');
        instagramBtn?.classList.remove('text-earth', 'hover:text-clay', 'hover:bg-paper/85');

        // Apply grid wrapper classes to the main list
        postsList.className = "grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 p-0 m-0 list-none transition-all duration-300";

        // Style items to Instagram Mode
        items.forEach((item) => {
          // Card outer element
          item.className = "group relative aspect-square overflow-hidden rounded-2xl border border-earth/10 hover:border-earth/25 hover:shadow-xl hover:shadow-black/10 transition-all duration-300 flex flex-col justify-end";
          
          // Imagewrapper
          const imgWrapper = item.querySelector('.post-img-wrapper');
          if (imgWrapper) {
            imgWrapper.className = "post-img-wrapper absolute inset-0 w-full h-full z-0 overflow-hidden";
          }

          // Show Instagram Header, Hide Split Header
          const instaHeader = item.querySelector('.instagram-header');
          if (instaHeader) {
            instaHeader.className = "instagram-header absolute top-4 inset-x-4 z-10 flex justify-between items-start p-0";
          }
          const splitHeader = item.querySelector('.split-header');
          if (splitHeader) {
            splitHeader.className = "split-header hidden";
          }

          // Category Pill (scoped to instagram-header)
          const pill = item.querySelector('.instagram-header span');
          if (pill) {
            pill.className = "inline-flex items-center rounded-full bg-white/20 backdrop-blur-md border border-white/20 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white shadow-sm";
          }

          // Date element (scoped to instagram-header)
          const timeEl = item.querySelector('.instagram-header time');
          if (timeEl) {
            timeEl.className = "post-time-element mt-1 text-[10px] font-semibold uppercase tracking-widest text-white/90 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]";
          }

          // Content Scrim
          const scrim = item.querySelector('.instagram-scrim');
          if (scrim) {
            scrim.classList.remove('opacity-0');
            scrim.classList.add('opacity-80', 'group-hover:opacity-100');
          }

          // Body text container
          const bodyContainer = item.querySelector('.post-body-container');
          if (bodyContainer) {
            bodyContainer.className = "post-body-container absolute inset-x-0 bottom-0 top-16 z-10 flex flex-col justify-end px-6 pb-6 overflow-hidden text-white transition-transform duration-300 ease-out group-hover:-translate-y-1 will-change-transform";
          }

          // H2 title heading
          const title = item.querySelector('.post-title-heading');
          if (title) {
            title.className = "post-title-heading mb-1 font-serif text-xl font-medium leading-tight drop-shadow-md group-hover:text-white line-clamp-3 transition-colors duration-300";
          }

          // Double wrappers for expand animations
          const expandWrapper = item.querySelector('.instagram-expand-wrapper');
          if (expandWrapper) {
            expandWrapper.className = "instagram-expand-wrapper grid grid-rows-[0fr] transition-all duration-300 ease-in-out group-hover:grid-rows-[1fr]";
          }
          const opacityWrapper = item.querySelector('.instagram-opacity-wrapper');
          if (opacityWrapper) {
            opacityWrapper.className = "instagram-opacity-wrapper overflow-hidden opacity-0 transition-opacity duration-300 group-hover:opacity-100";
          }

          // Inner description
          const desc = item.querySelector('.post-desc-p');
          if (desc) {
            desc.className = "post-desc-p mt-2 text-sm leading-relaxed text-white/90 line-clamp-2 text-justify";
          }

          // Tags section
          const tagsDiv = item.querySelector('.post-tags-container');
          if (tagsDiv) {
            tagsDiv.className = "post-tags-container mt-3 flex flex-wrap gap-2 border-none pt-0";
          }

          const tagItems = item.querySelectorAll('.post-tag-item');
          tagItems.forEach((tag) => {
            tag.className = "post-tag-item rounded-md bg-white/10 px-2 py-1 text-[10px] text-white/90 backdrop-blur-sm border border-white/10";
          });
        });

      } else {
        // Switch back to Split Mode
        splitBtn?.classList.add('text-clay', 'bg-clay/10');
        splitBtn?.classList.remove('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
        instagramBtn?.classList.remove('text-clay', 'bg-clay/10');
        instagramBtn?.classList.add('text-earth', 'hover:text-clay', 'hover:bg-paper/85');

        postsList.className = "flex flex-col gap-8 p-0 m-0 list-none transition-all duration-300";

        items.forEach((item) => {
          item.className = "group relative overflow-hidden rounded-2xl border border-earth/10 bg-paper/35 hover:bg-paper/70 hover:shadow-md hover:border-earth/20 transition-all duration-300 flex flex-col md:flex-row";

          const imgWrapper = item.querySelector('.post-img-wrapper');
          if (imgWrapper) {
            imgWrapper.className = "post-img-wrapper block w-full md:w-[35%] shrink-0 h-48 md:aspect-[4/3] overflow-hidden relative z-20";
          }

          // Hide Instagram Header, Show Split Header
          const instaHeader = item.querySelector('.instagram-header');
          if (instaHeader) {
            instaHeader.className = "instagram-header hidden";
          }
          const splitHeader = item.querySelector('.split-header');
          if (splitHeader) {
            splitHeader.className = "split-header flex justify-between items-center mb-3";
          }

          // Category Pill (scoped to split-header)
          const pill = item.querySelector('.split-header span');
          if (pill) {
            pill.className = "inline-flex items-center rounded-full bg-clay/5 text-clay border border-clay/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider shadow-sm transition-all duration-300";
          }

          // Date element (scoped to split-header)
          const timeEl = item.querySelector('.split-header time');
          if (timeEl) {
            timeEl.className = "post-time-element text-xs font-sans text-ink-soft/60 tracking-wider transition-all duration-300";
          }

          const scrim = item.querySelector('.instagram-scrim');
          if (scrim) {
            scrim.classList.add('opacity-0');
            scrim.classList.remove('opacity-80', 'group-hover:opacity-100');
          }

          const bodyContainer = item.querySelector('.post-body-container');
          if (bodyContainer) {
            bodyContainer.className = "post-body-container flex-1 p-5 md:p-6 flex flex-col justify-start z-10";
          }

          const title = item.querySelector('.post-title-heading');
          if (title) {
            title.className = "post-title-heading font-serif text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20";
          }

          const expandWrapper = item.querySelector('.instagram-expand-wrapper');
          if (expandWrapper) {
            expandWrapper.className = "instagram-expand-wrapper transition-all duration-300 ease-in-out";
          }
          const opacityWrapper = item.querySelector('.instagram-opacity-wrapper');
          if (opacityWrapper) {
            opacityWrapper.className = "instagram-opacity-wrapper transition-opacity duration-300";
          }

          const desc = item.querySelector('.post-desc-p');
          if (desc) {
            desc.className = "post-desc-p font-sans text-sm text-ink-soft leading-relaxed text-justify line-clamp-3";
          }

          const tagsDiv = item.querySelector('.post-tags-container');
          if (tagsDiv) {
            tagsDiv.className = "post-tags-container flex flex-wrap gap-2 pt-3 mt-3 border-t border-earth/5 relative z-20";
          }

          const tagItems = item.querySelectorAll('.post-tag-item');
          tagItems.forEach((tag) => {
            tag.className = "post-tag-item text-[10px] font-sans text-earth/70 transition-all duration-300";
          });
        });
      }
    }

    // Set layout toggle listeners
    splitBtn?.addEventListener('click', () => applyLayout('split'));
    instagramBtn?.addEventListener('click', () => applyLayout('instagram'));

    // Apply layout on load
    applyLayout(currentLayout);

    function filterPosts() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const title = el.dataset.title || '';
        const desc = el.dataset.desc || '';
        const category = el.dataset.category || '';
        const tags = JSON.parse(el.dataset.tags || '[]');

        const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesTag = !activeTag || tags.includes(activeTag);

        if (matchesSearch && matchesCategory && matchesTag) {
          el.style.setProperty('display', currentLayout === 'instagram' ? 'block' : 'flex', 'important');
          visibleCount++;
        } else {
          el.style.setProperty('display', 'none', 'important');
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterPosts();
    });

    // Category button handler
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active', 'bg-clay/10', 'text-clay');
          b.classList.add('text-earth');
        });
        btn.classList.add('active', 'bg-clay/10', 'text-clay');
        btn.classList.remove('text-earth');

        activeCategory = btn.getAttribute('data-category-btn') || 'all';
        filterPosts();
      });
    });

    // Tag button handler
    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedTag = btn.getAttribute('data-tag-btn');
        
        if (activeTag === selectedTag) {
          // Toggle off
          activeTag = null;
          btn.classList.remove('bg-clay/10', 'text-clay', 'border-clay');
          btn.classList.add('bg-paper/30', 'text-earth', 'border-earth/10');
        } else {
          // Toggle on
          tagBtns.forEach(b => {
            b.classList.remove('bg-clay/10', 'text-clay', 'border-clay');
            b.classList.add('bg-paper/30', 'text-earth', 'border-earth/10');
          });
          activeTag = selectedTag;
          btn.classList.add('bg-clay/10', 'text-clay', 'border-clay');
          btn.classList.remove('bg-paper/30', 'text-earth', 'border-earth/10');
        }
        filterPosts();
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltersAndLayouts);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFiltersAndLayouts);
  } else {
    initFiltersAndLayouts();
  }
</script>
