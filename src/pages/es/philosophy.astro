---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const lang = 'es';
const allPages = await getCollection('pages_es');
const entry = allPages.find(p => p.id === 'philosophy');
if (!entry) throw new Error(`philosophy not found. IDs: ${allPages.map(p => p.id).join(', ')}`);

let Content: any = null;
let renderError = false;
try {
  const rendered = await render(entry);
  Content = rendered.Content;
} catch (e) {
  console.error(`[Astro] Error rendering philosophy:`, e);
  renderError = true;
}
const { title, description } = entry.data;
---

<Layout title={title} description={description} lang="es">
  <div class="max-w-3xl mx-auto mt-8 relative">

    <div class="absolute -left-12 top-0 bottom-0 w-[1px] bg-earth/20 hidden md:block"></div>
    <div class="absolute -left-[12.5px] top-0 bottom-0 w-[2px] hidden md:block"
         style="background: linear-gradient(to bottom, transparent 0%, var(--clay, #8B2020) 8%, var(--clay, #8B2020) 92%, transparent 100%); opacity: 0.15;"></div>

    <header class="mb-16">
      <p class="eyebrow mb-4">Filosofía Educativa</p>
      <h1 class="text-4xl md:text-6xl font-serif text-ink tracking-tight mb-6">{title}</h1>
      {description && (
        <p class="text-xl text-ink-light font-serif italic border-l-2 border-clay pl-4">
          {description}
        </p>
      )}
    </header>

    <div class="philosophy-prose prose prose-lg max-w-none">
      {!renderError && Content ? <Content /> : <p>Error loading content.</p>}
    </div>

    <div class="mt-16 pt-8 border-t border-earth/20 flex items-center justify-between print:hidden">
      <a href="/es/cv" class="text-xs uppercase tracking-widest text-earth hover:text-clay font-sans transition-colors">
        &rarr; Curriculum Vitae
      </a>
      <button
        onclick="window.print()"
        class="text-xs font-sans uppercase tracking-widest text-ink/50 hover:text-clay transition-colors flex items-center gap-2"
        aria-label="Imprimir esta página"
      >
        <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="2" y="1" width="8" height="6" rx="0.5"/>
          <path d="M2 7v3a.5.5 0 00.5.5h7a.5.5 0 00.5-.5V7"/>
          <path d="M4 5h4M4 8h4M4 9.5h2"/>
        </svg>
        Imprimir
      </button>
    </div>
  </div>
</Layout>

<style>
  :root {
    --clay:     #8B2020;
    --earth:    #7a6a52;
    --ink:      #1a1714;
    --ink-soft: #4a453f;
    --sand:     #f5f1ea;
    --serif:    'Lora', Georgia, serif;
  }

  .philosophy-prose > p:first-of-type::first-letter {
    font-family: var(--serif);
    font-size: 3.8rem;
    font-weight: 300;
    line-height: 0.78;
    float: left;
    margin-right: 4px;
    margin-top: 4px;
    color: var(--clay);
  }

  .philosophy-prose p {
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.82;
    color: var(--ink-soft);
    text-align: justify;
    hyphens: auto;
    margin-bottom: 1.4rem;
  }

  .philosophy-prose h2 {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-top: 2.8rem;
    margin-bottom: 1rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--clay);
  }

  .philosophy-prose h3 {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .philosophy-prose em {
    font-style: italic;
    color: var(--clay);
    font-family: var(--serif);
  }

  .philosophy-prose strong { font-weight: 500; color: var(--ink); }

  .philosophy-prose blockquote {
    border-left: 2px solid var(--clay);
    padding-left: 1.2rem;
    margin-left: 0;
    font-style: italic;
    color: var(--ink-soft);
  }

  .philosophy-prose a {
    color: var(--clay);
    text-decoration: underline;
    text-decoration-color: rgba(139, 32, 32, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .philosophy-prose a:hover { text-decoration-color: var(--clay); }

  .philosophy-prose hr {
    border: none;
    text-align: center;
    margin: 2.5rem 0;
  }
  .philosophy-prose hr::after {
    content: '✦  ✦  ✦';
    font-family: var(--serif);
    color: var(--clay);
    opacity: 0.4;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
  }

  @media print {
    header { margin-bottom: 8mm !important; }
    .philosophy-prose p { font-size: 10.5pt; line-height: 1.55; }
    .philosophy-prose h2 { font-size: 11pt; }
  }
</style>
