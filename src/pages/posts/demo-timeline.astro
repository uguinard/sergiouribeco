---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('posts_en');
// Sort by date desc
const allPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Demo: Journal Timeline | Sergio Uribe" description="Demo page for Minimalist Journal Timeline Layout">
  <div class="max-w-3xl mx-auto px-4 py-8">
    <div class="mb-12 flex justify-between items-center border-b border-earth/10 pb-6">
      <div>
        <h1 class="font-serif text-3xl text-ink font-medium">Demo: Minimalist Journal Timeline</h1>
        <p class="font-sans text-sm text-ink-soft mt-1">Navigate back to <a href="/posts" class="text-clay underline">Standard Posts</a> or view other demos</p>
      </div>
      <div class="flex flex-wrap gap-2 font-sans text-xs">
        <a href="/posts/demo-grid" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Grid</a>
        <a href="/posts/demo-split" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Split</a>
        <a href="/posts/demo-timeline" class="bg-clay text-paper px-3 py-1.5 rounded font-medium">Timeline</a>
        <a href="/posts/demo-instagram" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Instagram</a>
      </div>
    </div>

    <!-- Vertical Timeline Line -->
    <div class="relative border-l border-earth/15 md:ml-24 pl-8 md:pl-12 space-y-16">
      {allPosts.map(post => (
        <article class="group relative">
          <!-- Bullet Node -->
          <div class="absolute -left-[38px] md:-left-[54px] top-1.5 w-3 h-3 rounded-full border-2 border-clay bg-sand transition-transform duration-300 group-hover:scale-125 group-hover:bg-clay"></div>

          <!-- Date label floating left on larger screens -->
          <time class="hidden md:block absolute -left-[180px] top-0 w-32 text-right font-sans text-xs font-bold uppercase tracking-widest text-earth/60">
            {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
          </time>

          <div class="flex flex-col md:flex-row gap-6 items-start justify-between">
            <!-- Mobile time label -->
            <time class="md:hidden block font-sans text-xs font-bold uppercase tracking-widest text-earth/60 mb-2">
              {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>

            <div class="flex-1">
              <span class="text-[10px] font-sans font-bold uppercase tracking-widest text-clay mb-2 block">
                {post.data.category}
              </span>
              
              <h2 class="font-serif text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20">
                <a href={`/posts/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="font-sans text-sm text-ink-soft leading-relaxed text-justify mb-4">
                  {post.data.description}
                </p>
              )}

              {post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 relative z-20">
                  {post.data.tags.map(tag => (
                    <span class="text-[10px] font-sans text-earth/60 hover:text-clay transition-colors">#{tag}</span>
                  ))}
                </div>
              )}
            </div>

            {post.data.thumbnail && (
              <a href={`/posts/${post.id}`} class="block w-20 h-20 shrink-0 rounded-lg overflow-hidden border border-earth/10 relative z-20 group-hover:border-clay/40 transition-colors">
                <Image 
                  src={post.data.thumbnail} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width={120}
                  height={120}
                />
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
