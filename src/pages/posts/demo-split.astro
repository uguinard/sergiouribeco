---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('posts_en');
// Sort by date desc
const allPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Demo: Split Cover | Sergio Uribe" description="Demo page for Horizontal Split Cover Layout">
  <div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-12 flex justify-between items-center border-b border-earth/10 pb-6">
      <div>
        <h1 class="font-serif text-3xl text-ink font-medium">Demo: Full-Height Split Cover</h1>
        <p class="font-sans text-sm text-ink-soft mt-1">Navigate back to <a href="/posts" class="text-clay underline">Standard Posts</a> or view other demos</p>
      </div>
      <div class="flex gap-3 font-sans text-xs">
        <a href="/posts/demo-grid" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Grid</a>
        <a href="/posts/demo-split" class="bg-clay text-paper px-3 py-1.5 rounded font-medium">Split</a>
        <a href="/posts/demo-timeline" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Timeline</a>
      </div>
    </div>

    <div class="space-y-8">
      {allPosts.map(post => (
        <article class="group flex flex-col md:flex-row overflow-hidden rounded-2xl border border-earth/10 bg-paper/35 hover:bg-paper/70 hover:shadow-md hover:border-earth/20 transition-all duration-300 relative min-h-[220px]">
          {post.data.thumbnail && (
            <a href={`/posts/${post.id}`} class="block w-full md:w-[35%] shrink-0 h-48 md:h-auto overflow-hidden relative z-20">
              <Image 
                src={post.data.thumbnail} 
                alt={post.data.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                width={350}
                height={220}
              />
            </a>
          )}

          <div class="flex-1 p-6 md:p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-sans font-bold uppercase tracking-wider bg-clay/5 text-clay border border-clay/10 px-2 py-0.5 rounded">
                  {post.data.category}
                </span>
                <time class="text-xs font-sans text-ink-soft/60 tracking-wider">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>

              <h2 class="font-serif text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20">
                <a href={`/posts/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="font-sans text-sm text-ink-soft leading-relaxed text-justify line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>

            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap gap-2 pt-4 border-t border-earth/5 mt-4 relative z-20">
                {post.data.tags.map(tag => (
                  <span class="text-[10px] font-sans text-earth/70">#{tag}</span>
                ))}
              </div>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</Layout>
