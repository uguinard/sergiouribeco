---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PostFilters from '../../components/PostFilters.astro';

const allPosts = await getCollection('posts_en', ({ data }) => 
  import.meta.env.PROD ? data.draft !== true : true
);

// Sort posts by pubDate desc
allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

console.log("POST DATA DEBUGLOG:", allPosts.map(p => ({ id: p.id, thumbnail: p.data.thumbnail })));

// Get all unique categories
const categories = Array.from(new Set(allPosts.map(p => p.data.category)));
const allTags = Array.from(new Set(allPosts.flatMap(p => p.data.tags)));
---

<Layout title="Posts">
  <div class="max-w-6xl mx-auto px-4 md:px-6">
    <div class="mb-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 border-b border-earth/10 pb-8">
      <div>
        <h1 class="text-4xl md:text-5xl font-serif text-ink tracking-tight mb-3 font-light">Articles & Reflections</h1>
        <p class="font-serif text-lg text-ink-soft italic leading-relaxed max-w-2xl">
          Writing on language enaction, 4E Cognition, and relational safety in international classrooms.
        </p>
      </div>
      <!-- Layout Switcher Toggle -->
      <div class="flex items-center gap-1.5 bg-paper/50 border border-earth/15 p-1 rounded-xl shadow-sm self-stretch md:self-auto justify-center">
        <button 
          id="layout-split-btn"
          class="flex items-center gap-2 px-4 py-2 text-xs font-sans font-medium rounded-lg text-clay bg-clay/10 transition-all duration-300"
          aria-label="Switch to Split Layout"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M9 3v18"/></svg>
          Split
        </button>
        <button 
          id="layout-instagram-btn"
          class="flex items-center gap-2 px-4 py-2 text-xs font-sans font-medium rounded-lg text-earth hover:text-clay hover:bg-paper/85 transition-all duration-300"
          aria-label="Switch to Instagram Grid Layout"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M3 9h18"/><path d="M3 15h18"/><path d="M9 3v18"/><path d="M15 3v18"/></svg>
          Instagram
        </button>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-10 items-start">
      <PostFilters allTags={allTags} categories={categories} />

      <div class="relative">
        <!-- Main Content: Articles Container -->
        <div class="space-y-6">
          <div id="posts-container" class="space-y-6">
            {allPosts.length === 0 ? (
              <div class="p-8 text-center border border-dashed border-earth/25 rounded-2xl">
                <p class="font-serif text-ink-soft italic">No articles found.</p>
              </div>
            ) : (
              <ul id="posts-list" class="group/list flex flex-col gap-8 p-0 m-0 list-none transition-all duration-300 data-[layout=instagram]:grid data-[layout=instagram]:grid-cols-1 data-[layout=instagram]:sm:grid-cols-2 data-[layout=instagram]:lg:grid-cols-3 data-[layout=instagram]:gap-6" data-layout="split">
                {allPosts.map(post => {
                  const formattedDate = post.data.pubDate.toLocaleDateString('en-US', { 
                    month: 'short', day: 'numeric', year: 'numeric' 
                  });
                  const isoDate = post.data.pubDate.toISOString();

                  return (
                    <li 
                      data-post-card
                      data-title={post.data.title.toLowerCase()}
                      data-desc={(post.data.description || '').toLowerCase()}
                      data-category={post.data.category}
                      data-tags={JSON.stringify(post.data.tags)}
                      class="group relative overflow-hidden rounded-2xl border border-earth/10 bg-paper/35 hover:bg-paper/70 hover:shadow-md hover:border-earth/20 transition-all duration-300 flex flex-col md:flex-row group-data-[layout=instagram]/list:aspect-square group-data-[layout=instagram]/list:hover:border-earth/25 group-data-[layout=instagram]/list:hover:shadow-xl group-data-[layout=instagram]/list:hover:shadow-black/10 group-data-[layout=instagram]/list:flex-col group-data-[layout=instagram]/list:justify-end"
                    >
                      <!-- Image Area -->
                      {post.data.thumbnail ? (
                        <a href={`/posts/${post.id}`} class="post-img-wrapper block w-full md:w-[35%] shrink-0 h-48 md:aspect-[4/3] overflow-hidden relative z-20 group-data-[layout=instagram]/list:absolute group-data-[layout=instagram]/list:inset-0 group-data-[layout=instagram]/list:w-full group-data-[layout=instagram]/list:h-full group-data-[layout=instagram]/list:z-0">
                          <Image 
                            src={post.data.thumbnail} 
                            alt={post.data.title} 
                            class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform"
                            width={600}
                            height={600}
                            sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <div class="post-img-wrapper block w-full md:w-[35%] shrink-0 h-48 md:aspect-[4/3] overflow-hidden relative z-20 bg-gradient-to-br from-earth/15 to-clay/15 transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform group-data-[layout=instagram]/list:absolute group-data-[layout=instagram]/list:inset-0 group-data-[layout=instagram]/list:w-full group-data-[layout=instagram]/list:h-full group-data-[layout=instagram]/list:z-0"></div>
                      )}

                      <!-- Top overlay overlay gradient (Instagram mode only) -->
                      <div class="instagram-scrim absolute inset-0 bg-gradient-to-t from-black/90 via-black/45 to-transparent opacity-0 pointer-events-none transition-opacity duration-300 z-10 group-data-[layout=instagram]/list:opacity-80 group-data-[layout=instagram]/list:group-hover:opacity-100"></div>

                      <!-- Floating header container (h-aligned category & date, dynamic positioning) -->
                      <div class="instagram-header absolute top-4 inset-x-4 z-10 flex justify-between items-start p-0 hidden group-data-[layout=instagram]/list:flex">
                        <span class="inline-flex items-center rounded-full bg-clay/5 text-clay border border-clay/10 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-widest shadow-sm transition-all duration-300 group-data-[layout=instagram]/list:bg-white/20 group-data-[layout=instagram]/list:backdrop-blur-md group-data-[layout=instagram]/list:border-white/20 group-data-[layout=instagram]/list:px-3 group-data-[layout=instagram]/list:py-1 group-data-[layout=instagram]/list:text-white">
                          {post.data.category}
                        </span>
                        <time datetime={isoDate} class="post-time-element text-xs font-sans text-ink-soft/60 tracking-wider transition-all duration-300 group-data-[layout=instagram]/list:mt-1 group-data-[layout=instagram]/list:text-[10px] group-data-[layout=instagram]/list:font-semibold group-data-[layout=instagram]/list:uppercase group-data-[layout=instagram]/list:tracking-widest group-data-[layout=instagram]/list:text-white/90 group-data-[layout=instagram]/list:drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                          {formattedDate}
                        </time>
                      </div>

                      <!-- Content body area -->
                      <div class="post-body-container flex-1 p-5 md:p-6 flex flex-col justify-start z-10 group-data-[layout=instagram]/list:absolute group-data-[layout=instagram]/list:inset-x-0 group-data-[layout=instagram]/list:bottom-0 group-data-[layout=instagram]/list:top-16 group-data-[layout=instagram]/list:justify-end group-data-[layout=instagram]/list:px-6 group-data-[layout=instagram]/list:pb-6 group-data-[layout=instagram]/list:overflow-hidden group-data-[layout=instagram]/list:text-white group-data-[layout=instagram]/list:transition-transform group-data-[layout=instagram]/list:duration-300 group-data-[layout=instagram]/list:ease-out group-data-[layout=instagram]/list:group-hover:-translate-y-1 group-data-[layout=instagram]/list:will-change-transform">
                        <div>
                          <!-- Header container inside body (Split mode) -->
                          <div class="split-header flex justify-between items-center mb-3 group-data-[layout=instagram]/list:hidden">
                            <span class="inline-flex items-center rounded-full bg-clay/5 text-clay border border-clay/10 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider shadow-sm transition-all duration-300">
                              {post.data.category}
                            </span>
                            <time datetime={isoDate} class="post-time-element text-xs font-sans text-ink-soft/60 tracking-wider transition-all duration-300">
                              {formattedDate}
                            </time>
                          </div>

                          <h2 class="post-title-heading font-serif text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20 group-data-[layout=instagram]/list:mb-1 group-data-[layout=instagram]/list:leading-tight group-data-[layout=instagram]/list:drop-shadow-md group-data-[layout=instagram]/list:text-white group-data-[layout=instagram]/list:line-clamp-3">
                            <a href={`/posts/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                              {post.data.title}
                            </a>
                          </h2>

                          <!-- Expandable layout helper wrapper -->
                          <div class="instagram-expand-wrapper transition-all duration-300 ease-in-out group-data-[layout=instagram]/list:grid group-data-[layout=instagram]/list:grid-rows-[0fr] group-data-[layout=instagram]/list:group-hover:grid-rows-[1fr]">
                            <div class="instagram-opacity-wrapper transition-opacity duration-300 group-data-[layout=instagram]/list:overflow-hidden group-data-[layout=instagram]/list:opacity-0 group-data-[layout=instagram]/list:group-hover:opacity-100">
                              {post.data.description && (
                                <p class="post-desc-p font-sans text-sm text-ink-soft leading-relaxed text-justify line-clamp-3 group-data-[layout=instagram]/list:mt-2 group-data-[layout=instagram]/list:text-white/90 group-data-[layout=instagram]/list:line-clamp-2">
                                  {post.data.description}
                                </p>
                              )}

                              {post.data.tags.length > 0 && (
                                <div class="post-tags-container flex flex-wrap gap-2 pt-3 mt-3 border-t border-earth/5 relative z-20 group-data-[layout=instagram]/list:mt-3 group-data-[layout=instagram]/list:border-none group-data-[layout=instagram]/list:pt-0">
                                  {post.data.tags.map(tag => (
                                    <span class="post-tag-item text-[10px] font-sans text-earth/70 transition-all duration-300 group-data-[layout=instagram]/list:rounded-md group-data-[layout=instagram]/list:bg-white/10 group-data-[layout=instagram]/list:px-2 group-data-[layout=instagram]/list:py-1 group-data-[layout=instagram]/list:text-white/90 group-data-[layout=instagram]/list:backdrop-blur-sm group-data-[layout=instagram]/list:border-white/10">#{tag}</span>
                                  ))}
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ul>
            )}
            <!-- Empty State (js controlled) -->
            <div id="posts-empty" class="hidden p-12 text-center border border-dashed border-earth/20 rounded-2xl">
              <span class="text-2xl mb-2 block">🔍</span>
              <p class="font-serif text-ink-soft italic">No articles match your search parameters.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  function initFiltersAndLayouts() {
    const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
    const catBtns = document.querySelectorAll('[data-category-btn]');
    const tagBtns = document.querySelectorAll('[data-tag-btn]');
    const cards = document.querySelectorAll('[data-post-card]');
    const emptyState = document.getElementById('posts-empty');

    const postsList = document.getElementById('posts-list');
    const splitBtn = document.getElementById('layout-split-btn');
    const instagramBtn = document.getElementById('layout-instagram-btn');

    let activeCategory = 'all';
    let activeTag: string | null = null;
    let searchQuery = '';
    let currentLayout = localStorage.getItem('posts-layout') || 'split';

    // Layout applicator function
    function applyLayout(layout: string) {
      if (!postsList) return;
      currentLayout = layout;
      localStorage.setItem('posts-layout', layout);
      postsList.setAttribute('data-layout', layout);

      if (layout === 'instagram') {
        // Toggle buttons active classes
        splitBtn?.classList.remove('text-clay', 'bg-clay/10');
        splitBtn?.classList.add('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
        instagramBtn?.classList.add('text-clay', 'bg-clay/10');
        instagramBtn?.classList.remove('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
      } else {
        // Switch back to Split Mode
        splitBtn?.classList.add('text-clay', 'bg-clay/10');
        splitBtn?.classList.remove('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
        instagramBtn?.classList.remove('text-clay', 'bg-clay/10');
        instagramBtn?.classList.add('text-earth', 'hover:text-clay', 'hover:bg-paper/85');
      }
    }

    // Set layout toggle listeners
    splitBtn?.addEventListener('click', () => applyLayout('split'));
    instagramBtn?.addEventListener('click', () => applyLayout('instagram'));

    // Apply layout on load
    applyLayout(currentLayout);

    function filterPosts() {
      let visibleCount = 0;

      cards.forEach((card) => {
        const el = card as HTMLElement;
        const title = el.dataset.title || '';
        const desc = el.dataset.desc || '';
        const category = el.dataset.category || '';
        const tags = JSON.parse(el.dataset.tags || '[]');

        const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);
        const matchesCategory = activeCategory === 'all' || category === activeCategory;
        const matchesTag = !activeTag || tags.includes(activeTag);

        if (matchesSearch && matchesCategory && matchesTag) {
          el.style.display = '';
          visibleCount++;
        } else {
          el.style.display = 'none';
        }
      });

      if (emptyState) {
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }
    }

    // Search input handler
    searchInput?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.toLowerCase();
      filterPosts();
    });

    // Category button handler
    catBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.classList.remove('active', 'bg-clay/10', 'text-clay');
          b.classList.add('text-earth');
        });
        btn.classList.add('active', 'bg-clay/10', 'text-clay');
        btn.classList.remove('text-earth');

        activeCategory = btn.getAttribute('data-category-btn') || 'all';
        filterPosts();
      });
    });

    // Tag button handler
    tagBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const selectedTag = btn.getAttribute('data-tag-btn');
        
        if (activeTag === selectedTag) {
          // Toggle off
          activeTag = null;
          btn.classList.remove('bg-clay/10', 'text-clay', 'border-clay');
          btn.classList.add('bg-paper/30', 'text-earth', 'border-earth/10');
        } else {
          // Toggle on
          tagBtns.forEach(b => {
            b.classList.remove('bg-clay/10', 'text-clay', 'border-clay');
            b.classList.add('bg-paper/30', 'text-earth', 'border-earth/10');
          });
          activeTag = selectedTag;
          btn.classList.add('bg-clay/10', 'text-clay', 'border-clay');
          btn.classList.remove('bg-paper/30', 'text-earth', 'border-earth/10');
        }
        filterPosts();
      });
    });
  }

  document.addEventListener('astro:page-load', initFiltersAndLayouts);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFiltersAndLayouts);
  } else {
    initFiltersAndLayouts();
  }
</script>
