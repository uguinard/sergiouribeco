---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('posts_en');
// Sort by date desc
const allPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Get unique categories and tags
const categories = ['all', ...new Set(allPosts.map(p => p.data.category))];
const tags = [...new Set(allPosts.flatMap(p => p.data.tags))];
---

<Layout title="Demo: Magazine Grid | Sergio Uribe" description="Demo page for Editorial Magazine Grid Layout">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="mb-12 flex justify-between items-center border-b border-earth/10 pb-6">
      <div>
        <h1 class="font-serif text-3xl text-ink font-medium">Demo: Editorial Magazine Grid</h1>
        <p class="font-sans text-sm text-ink-soft mt-1">Navigate back to <a href="/posts" class="text-clay underline">Standard Posts</a> or view other demos</p>
      </div>
      <div class="flex flex-wrap gap-2 font-sans text-xs">
        <a href="/posts/demo-grid" class="bg-clay text-paper px-3 py-1.5 rounded font-medium">Grid</a>
        <a href="/posts/demo-split" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Split</a>
        <a href="/posts/demo-timeline" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Timeline</a>
        <a href="/posts/demo-instagram" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Instagram</a>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {allPosts.map(post => (
        <article class="group rounded-2xl border border-earth/10 bg-paper/35 hover:bg-paper/70 hover:shadow-md hover:border-earth/20 transition-all duration-300 flex flex-col justify-between overflow-hidden relative">
          <div>
            {post.data.thumbnail && (
              <a href={`/posts/${post.id}`} class="block w-full aspect-[16/10] overflow-hidden relative z-20">
                <Image 
                  src={post.data.thumbnail} 
                  alt={post.data.title} 
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  width={400}
                  height={250}
                />
              </a>
            )}

            <div class="p-6">
              <div class="flex items-center justify-between mb-3">
                <span class="text-[10px] font-sans font-bold uppercase tracking-wider bg-clay/5 text-clay border border-clay/10 px-2 py-0.5 rounded">
                  {post.data.category}
                </span>
                <time class="text-xs font-sans text-ink-soft/60 tracking-wider">
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </time>
              </div>

              <h2 class="font-serif text-lg md:text-xl text-ink font-medium tracking-tight mb-3 group-hover:text-clay transition-colors duration-300 relative z-20">
                <a href={`/posts/${post.id}`} class="after:absolute after:inset-0 after:content-['']">
                  {post.data.title}
                </a>
              </h2>

              {post.data.description && (
                <p class="font-sans text-sm text-ink-soft leading-relaxed text-justify line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </div>
          </div>

          {post.data.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5 px-6 pb-6 pt-3 border-t border-earth/5 relative z-20">
              {post.data.tags.map(tag => (
                <span class="text-[10px] font-sans text-earth/60">#{tag}</span>
              ))}
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</Layout>
