---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('posts_en');
// Sort by date desc
const allPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Demo: Instagram Grid | Sergio Uribe" description="Demo page for Instagram-like Square Grid Layout">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-12 flex justify-between items-center border-b border-earth/10 pb-6">
      <div>
        <h1 class="font-serif text-3xl text-ink font-medium">Demo: Instagram Grid</h1>
        <p class="font-sans text-sm text-ink-soft mt-1">Navigate back to <a href="/posts" class="text-clay underline">Standard Posts</a> or view other demos</p>
      </div>
      <div class="flex flex-wrap gap-2 font-sans text-xs">
        <a href="/posts/demo-grid" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Grid</a>
        <a href="/posts/demo-split" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Split</a>
        <a href="/posts/demo-timeline" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper">Timeline</a>
        <a href="/posts/demo-instagram" class="bg-clay text-paper px-3 py-1.5 rounded font-medium">Instagram</a>
      </div>
    </div>

    <!-- Instagram-like 3-Column Square Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {allPosts.map(post => (
        <article class="group relative aspect-square overflow-hidden rounded-2xl border border-earth/10 bg-paper/30 hover:shadow-lg transition-all duration-300">
          {post.data.thumbnail ? (
            <Image 
              src={post.data.thumbnail} 
              alt={post.data.title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              width={500}
              height={500}
            />
          ) : (
            <div class="w-full h-full bg-earth/5 flex items-center justify-center text-earth/30">
              <span class="font-serif italic text-sm">No Image</span>
            </div>
          )}

          <!-- Hover Overlay with Post Details -->
          <a 
            href={`/posts/${post.id}`} 
            class="absolute inset-0 bg-ink/75 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-between p-6 z-20 text-paper no-underline"
          >
            <div class="flex items-center justify-between text-[10px] font-sans tracking-widest uppercase text-paper/70">
              <span>{post.data.category}</span>
              <time>
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </time>
            </div>

            <div class="text-center my-auto px-2">
              <h2 class="font-serif text-lg md:text-xl font-medium leading-snug text-paper group-hover:text-clay transition-colors duration-300">
                {post.data.title}
              </h2>
              {post.data.description && (
                <p class="font-sans text-xs text-paper/80 mt-2 line-clamp-2 text-justify">
                  {post.data.description}
                </p>
              )}
            </div>

            {post.data.tags.length > 0 && (
              <div class="flex flex-wrap justify-center gap-1.5">
                {post.data.tags.slice(0, 3).map(tag => (
                  <span class="text-[9px] font-sans text-clay px-1.5 py-0.5 bg-clay/10 rounded">#{tag}</span>
                ))}
              </div>
            )}
          </a>
        </article>
      ))}
    </div>
  </div>
</Layout>
