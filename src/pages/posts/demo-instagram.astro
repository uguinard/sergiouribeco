---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';

const posts = await getCollection('posts_en');
const allPosts = posts
  .filter(p => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout title="Demo: Instagram Grid | Sergio Uribe" description="Demo page for Instagram-like Square Grid Layout">
  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="mb-12 flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-earth/10 pb-6">
      <div>
        <h1 class="font-serif text-3xl text-ink font-medium">Demo: Instagram Grid</h1>
        <p class="font-sans text-sm text-ink-soft mt-1">Navigate back to <a href="/posts" class="text-clay underline">Standard Posts</a> or view other demos</p>
      </div>
      <div class="flex flex-wrap gap-2 font-sans text-xs">
        <a href="/posts/demo-grid" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper transition-colors">Grid</a>
        <a href="/posts/demo-split" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper transition-colors">Split</a>
        <a href="/posts/demo-timeline" class="bg-paper/80 text-earth border border-earth/10 px-3 py-1.5 rounded hover:bg-paper transition-colors">Timeline</a>
        <a href="/posts/demo-instagram" class="bg-clay text-paper px-3 py-1.5 rounded font-medium">Instagram</a>
      </div>
    </div>

    <!-- 1. Semantic <ul> wrapper -->
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 p-0 m-0 list-none">
      {allPosts.map((post) => {
        const formattedDate = post.data.pubDate.toLocaleDateString('en-US', { 
          month: 'short', day: 'numeric', year: 'numeric' 
        });
        const isoDate = post.data.pubDate.toISOString();

        return (
          <li class="contents">
            <a 
              href={`/posts/${post.id}`} 
              class="group relative block aspect-[4/5] sm:aspect-square overflow-hidden rounded-2xl bg-earth/10 transition-all duration-300 hover:shadow-xl hover:shadow-black/10 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-clay/50"
              aria-label={`Read article: ${post.data.title}`}
            >
              
              {post.data.thumbnail ? (
                <Image 
                  src={post.data.thumbnail} 
                  alt="" 
                  class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform"
                  width={600}
                  height={600}
                  sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="absolute inset-0 h-full w-full bg-gradient-to-br from-earth/15 to-clay/15 transition-transform duration-700 ease-out group-hover:scale-110 will-change-transform"></div>
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-80 transition-opacity duration-300 group-hover:opacity-100 pointer-events-none"></div>

              <div class="absolute top-4 inset-x-4 z-10 flex justify-between items-start">
                <span class="inline-flex items-center rounded-full bg-white/20 backdrop-blur-md border border-white/20 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-white shadow-sm">
                  {post.data.category}
                </span>
                <time datetime={isoDate} class="mt-1 text-[10px] font-semibold uppercase tracking-widest text-white/90 drop-shadow-[0_2px_4px_rgba(0,0,0,0.8)]">
                  {formattedDate}
                </time>
              </div>

              <!-- Added will-change-transform here as well since it translates on hover -->
              <div class="absolute inset-x-0 bottom-0 top-16 z-10 flex flex-col justify-end px-6 pb-6 overflow-hidden text-white transition-transform duration-300 ease-out group-hover:-translate-y-1 will-change-transform">

                <h2 class="mb-1 font-serif text-xl font-medium leading-tight drop-shadow-md lg:text-2xl line-clamp-3">
                  {post.data.title}
                </h2>

                <div class="grid grid-rows-[0fr] transition-all duration-300 ease-in-out group-hover:grid-rows-[1fr]">
                  <div class="overflow-hidden opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                    {post.data.description && (
                      <p class="mt-2 text-sm leading-relaxed text-white/90 line-clamp-2">
                        {post.data.description}
                      </p>
                    )}

                    {post.data.tags.length > 0 && (
                      <div class="mt-3 flex flex-wrap gap-2">
                        {post.data.tags.slice(0, 3).map(tag => (
                          <span class="rounded-md bg-white/10 px-2 py-1 text-[10px] text-white/90 backdrop-blur-sm border border-white/10">
                            #{tag}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</Layout>
