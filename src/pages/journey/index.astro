---
import Layout from '../../layouts/Layout.astro';
import StoryTimelineMap from '../../components/MapGame.astro';
---

<Layout title="Life Journey Map">
  <main class="page-content">
    <section class="journey-hero">
      <p class="eyebrow mb-4">Story Timeline Map</p>
      <h1 class="text-4xl md:text-5xl font-serif text-ink tracking-tight mb-6">
        Life Journey Map
      </h1>
      <p class="text-xl text-ink-light font-serif italic max-w-3xl">
        An immersive map of the places that shaped how I teach, travel, and learn.
      </p>
    </section>

    <section class="mt-16">
      <StoryTimelineMap />
    </section>
  </main>
</Layout>

<style>
  .journey-hero {
    max-width: 68ch;
  }
</style>
