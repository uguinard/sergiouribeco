---
import { getCollection, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const lang = 'en';
const allPages = await getCollection('pages_en');
const entry = allPages.find(p => p.id === 'philosophy');
if (!entry) throw new Error(`philosophy not found. IDs: ${allPages.map(p => p.id).join(', ')}`);

let MarkdownContent: any = null;
let headings: any[] = [];
let renderError = false;
try {
  const rendered = await render(entry);
  MarkdownContent = rendered.Content;
  headings = rendered.headings || [];
} catch (e) {
  console.error(`[Astro] Error rendering philosophy:`, e);
  if (e && typeof e === 'object') {
    console.error(`[Astro] Error details:`, (e as any).cause || (e as any).message || e);
  }
  renderError = true;
}
const { title, description } = entry.data;
---

<Layout title={title} description={description}>
  <div class="max-w-5xl mx-auto mt-8 flex flex-col lg:flex-row gap-12 relative">

    <!-- Left Column: Sticky Outline (ToC) -->
    <aside class="w-full lg:w-56 shrink-0 print:hidden">
      <nav class="lg:sticky lg:top-28 p-5 border border-earth/10 lg:border-none bg-paper/30 lg:bg-transparent rounded-2xl lg:p-0 space-y-4">
        <p class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase">Outline</p>
        <ul class="space-y-3">
          {headings.filter(h => h.depth === 2).map(h => (
            <li>
              <a href={`#${h.slug}`} class="toc-link font-sans text-[11px] font-bold tracking-wider uppercase text-earth hover:text-clay transition-colors block py-1 pl-3 border-l border-earth/15 hover:border-clay">
                {h.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>

    <!-- Right Column: Content -->
    <div class="flex-1 max-w-3xl relative">
      <!-- One elegant vertical divider line -->
      <div class="absolute -left-6 top-0 bottom-0 w-[1px] bg-earth/15 hidden lg:block"></div>

      <header class="mb-16">
        <p class="eyebrow mb-4">Pedagogical Posture</p>
        <h1 class="text-4xl md:text-5xl font-serif text-ink tracking-tight mb-6">{title}</h1>
        {description && (
          <p class="text-xl text-ink-light font-serif italic border-l-2 border-clay pl-4">
            {description}
          </p>
        )}
      </header>

      <div class="philosophy-prose prose prose-lg max-w-none">
        {!renderError && MarkdownContent ? <MarkdownContent /> : <p>Error loading content.</p>}
      </div>

      <div class="mt-16 pt-8 border-t border-earth/20 flex items-center justify-between print:hidden">
        <a href="/cv" class="text-xs uppercase tracking-widest text-earth hover:text-clay font-sans transition-colors">
          &rarr; Curriculum Vitae
        </a>
        <button
          onclick="window.print()"
          class="text-xs font-sans uppercase tracking-widest text-ink/50 hover:text-clay transition-colors flex items-center gap-2"
          aria-label="Print this page"
        >
          <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="2" y="1" width="8" height="6" rx="0.5"/>
            <path d="M2 7v3a.5.5 0 00.5.5h7a.5.5 0 00.5-.5V7"/>
            <path d="M4 5h4M4 8h4M4 9.5h2"/>
          </svg>
          Print
        </button>
      </div>
    </div>

  </div>
</Layout>

<style>
  :root {
    --clay:     #8B2020;
    --earth:    #7a6a52;
    --ink:      #1a1714;
    --ink-soft: #4a453f;
    --sand:     #f5f1ea;
    --serif:    'Lora', Georgia, serif;
  }

  .philosophy-prose > p:first-of-type::first-letter {
    font-family: var(--serif);
    font-size: 3.8rem;
    font-weight: 300;
    line-height: 0.78;
    float: left;
    margin-right: 4px;
    margin-top: 4px;
    color: var(--clay);
  }

  .philosophy-prose :global(p) {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.82;
    color: var(--ink-soft);
    text-align: justify;
    hyphens: auto;
    margin-bottom: 1.4rem;
  }

  .philosophy-prose :global(h2) {
    font-family: var(--serif);
    font-size: 1.3rem;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
    margin-top: 2.8rem;
    margin-bottom: 1rem;
    padding-left: 0.75rem;
    border-left: 2px solid var(--clay);
    scroll-margin-top: 6.5rem;
  }

  .philosophy-prose :global(h3) {
    font-family: var(--serif);
    font-size: 1.05rem;
    font-weight: 500;
    color: var(--ink);
    margin-top: 2rem;
    margin-bottom: 0.75rem;
    scroll-margin-top: 6.5rem;
  }

  .philosophy-prose :global(em) {
    font-style: italic;
    color: var(--clay);
    font-family: var(--serif);
  }

  .philosophy-prose :global(strong) { font-weight: 500; color: var(--ink); }

  .philosophy-prose :global(blockquote) {
    border-left: 2px solid var(--clay);
    padding-left: 1.2rem;
    margin-left: 0;
    font-style: italic;
    color: var(--ink-soft);
  }

  .philosophy-prose :global(a) {
    color: var(--clay);
    text-decoration: underline;
    text-decoration-color: rgba(139, 32, 32, 0.35);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s;
  }
  .philosophy-prose :global(a:hover) { text-decoration-color: var(--clay); }

  .philosophy-prose :global(hr) {
    border: none;
    text-align: center;
    margin: 2.5rem 0;
  }
  .philosophy-prose :global(hr::after) {
    content: '✦  ✦  ✦';
    font-family: var(--serif);
    color: var(--clay);
    opacity: 0.4;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
  }

  @media print {
    header { margin-bottom: 8mm !important; }
    .philosophy-prose p { font-size: 10.5pt; line-height: 1.55; }
    .philosophy-prose h2 { font-size: 11pt; }
  }
</style>

<script>
  function initScrollSpy() {
    const headings = Array.from(document.querySelectorAll('.philosophy-prose h2'));
    const tocLinks = Array.from(document.querySelectorAll('.toc-link'));
    if (!headings.length || !tocLinks.length) return;

    const observerOptions = {
      root: null,
      rootMargin: '-10% 0px -75% 0px',
      threshold: 0
    };

    const observer = new IntersectionObserver((entries) => {
      // Find the first intersecting entry
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute('id');
          tocLinks.forEach((link) => {
            if (link.getAttribute('href') === `#${id}`) {
              link.classList.add('text-clay', 'border-clay');
              link.classList.remove('text-earth', 'border-earth/15');
            } else {
              link.classList.remove('text-clay', 'border-clay');
              link.classList.add('text-earth', 'border-earth/15');
            }
          });
        }
      });
    }, observerOptions);

    headings.forEach((heading) => observer.observe(heading));
  }

  // Support both page loads and view transitions
  document.addEventListener('astro:page-load', initScrollSpy);
  // Fallback for initial load when ViewTransitions aren't fully intercepting
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScrollSpy);
  } else {
    initScrollSpy();
  }
</script>
