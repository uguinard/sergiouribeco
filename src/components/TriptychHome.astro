---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "IB-Certified Language & Humanities Specialist",
    
    // Column 1
    col1Label: "01 / PRESENCE & CONTACT",
    contactEmail: "Email: contact@sergiouribe.co",
    contactLocation: "Location: Bangkok, Thailand (UWC)",
    contactWeb: "Website: sergiouribe.co",
    
    // Column 2
    col2Label: "02 / PITCH & CAPABILITIES",
    pitchTitle: "The Dual-Language Architect",
    pitchText: "Designing inquiry-based language acquisition pathways that respect cognitive architecture. Leveraging my Master's in ELE and background in EAL to scaffold literary and conceptual understanding.",
    skillsTitle: "EdTech & Development",
    skillsText: "Building tailored interactive resources with Python and H5P pipelines to respect student individuality rather than buying off-the-shelf software.",

    // Column 3
    col3Label: "03 / HOLISTIC PHILOSOPHY",
    philTitle: "Ubuntu & Restorative Circles",
    philText1: "I believe that relationships must precede rules. My classroom environment centers Ubuntu: the foundational belief that we only exist through our connections with others.",
    philText2: "By centering restorative circles and somatic emotional support, I help co-create safe, self-regulating international school communities.",
    
    // CTAs
    cvLink: "Explore CV ➔",
    pdfLink: "Download Dossier (PDF) ⬇"
  },
  es: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "Especialista en Lengua y Humanidades Certificado IB",
    
    // Column 1
    col1Label: "01 / PRESENCIA Y CONTACTO",
    contactEmail: "Email: contacto@sergiouribe.co",
    contactLocation: "Ubicación: Bangkok, Tailandia (UWC)",
    contactWeb: "Sitio web: sergiouribe.co",
    
    // Column 2
    col2Label: "02 / ENFOQUE Y CAPACIDADES",
    pitchTitle: "Arquitecto del Lenguaje Dual",
    pitchText: "Diseño rutas de adquisición de lenguas basadas en indagación que respetan la arquitectura cognitiva. Con mi Máster en ELE y experiencia en EAL, andamio la comprensión literaria y conceptual.",
    skillsTitle: "EdTech y Desarrollo",
    skillsText: "Construyo recursos interactivos adaptados mediante Python y H5P para respetar la individualidad del alumno en lugar de comprar software prefabricado.",

    // Column 3
    col3Label: "03 / FILOSOFÍA HOLÍSTICA",
    philTitle: "Ubuntu y Círculos Restaurativos",
    philText1: "Las relaciones deben preceder a las normas. Mi aula se fundamenta en Ubuntu: la creencia de que solo existimos a través de nuestras conexiones con los demás.",
    philText2: "Al centrar los círculos restaurativos y el apoyo emocional somático, coopero en la creación de comunidades escolares internacionales seguras y autorreguladas.",
    
    // CTAs
    cvLink: "Ver Currículum ➔",
    pdfLink: "Descargar Dossier (PDF) ⬇"
  }
};

const t = content[lang] || content.en;
---

<div class="triptych-container max-w-6xl mx-auto px-6 py-12 md:py-20 text-[#1C1A17] bg-[#F7F4EE]">
  
  <!-- Minimalist Title Header -->
  <header class="border-b border-[#1C1A17]/15 pb-6 mb-12">
    <h1 class="font-serif text-3xl md:text-5xl font-normal tracking-tight leading-none mb-2">
      {t.title}
    </h1>
    <p class="font-sans text-[10px] md:text-xs font-bold tracking-[0.25em] text-[#8B2020] uppercase">
      {t.subtitle}
    </p>
  </header>

  <!-- The Triptych Grid (3 Columns) -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-12 items-start">
    
    <!-- Column 1: Video Anchor & Contact -->
    <div class="flex flex-col gap-8">
      <span class="font-mono text-[9px] tracking-widest text-[#8B2020] uppercase border-b border-[#1C1A17]/10 pb-2">
        {t.col1Label}
      </span>
      
      <!-- Video Container -->
      <div class="w-full aspect-video bg-black rounded overflow-hidden shadow-md border border-[#1C1A17]/10">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/AusbshtWUnE" 
          title="Sergio Uribe Guinard - Introduction" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen
        ></iframe>
      </div>

      <!-- Contact Info -->
      <div class="font-serif text-xs leading-relaxed text-[#1C1A17]/80 flex flex-col gap-1.5">
        <p class="font-medium text-[#1C1A17]">{t.contactEmail}</p>
        <p>{t.contactLocation}</p>
        <p>{t.contactWeb}</p>
      </div>
    </div>

    <!-- Column 2: Pitch & Skills -->
    <div class="flex flex-col gap-8">
      <span class="font-mono text-[9px] tracking-widest text-[#8B2020] uppercase border-b border-[#1C1A17]/10 pb-2">
        {t.col2Label}
      </span>

      <!-- Pitch -->
      <div>
        <h3 class="font-serif text-xl font-normal mb-3 text-[#1C1A17]">
          {t.pitchTitle}
        </h3>
        <p class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/80">
          {t.pitchText}
        </p>
      </div>

      <!-- Skills -->
      <div>
        <h3 class="font-serif text-lg font-normal mb-3 text-[#1C1A17]">
          {t.skillsTitle}
        </h3>
        <p class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/80">
          {t.skillsText}
        </p>
      </div>
    </div>

    <!-- Column 3: Philosophy -->
    <div class="flex flex-col gap-8">
      <span class="font-mono text-[9px] tracking-widest text-[#8B2020] uppercase border-b border-[#1C1A17]/10 pb-2">
        {t.col3Label}
      </span>

      <div>
        <h3 class="font-serif text-xl font-normal mb-3 text-[#1C1A17]">
          {t.philTitle}
        </h3>
        <p class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/80 mb-4">
          {t.philText1}
        </p>
        <p class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/80">
          {t.philText2}
        </p>
      </div>
    </div>

  </div>

  <!-- Bottom CTA Footer -->
  <footer class="border-t border-[#1C1A17]/15 mt-16 pt-8 flex justify-between items-center text-xs">
    <a 
      href={`/${lang === 'en' ? '' : lang + '/'}cv`}
      class="font-sans font-bold tracking-widest text-[#1C1A17] hover:text-[#8B2020] uppercase transition-colors"
    >
      {t.cvLink}
    </a>
    <a 
      href="/cv"
      class="font-sans font-bold tracking-widest text-[#8B2020] hover:text-[#1C1A17] uppercase transition-colors"
    >
      {t.pdfLink}
    </a>
  </footer>
</div>

<style>
  /* Strict cream/ink theme */
  :global(body) {
    background-color: #F7F4EE !important;
    color: #1C1A17 !important;
  }
  
  :global(body header) {
    background-color: rgba(247, 244, 238, 0.95) !important;
    border-color: rgba(28, 26, 23, 0.1) !important;
  }

  :global(body nav a), :global(body .nav-item) {
    color: #1C1A17 !important;
  }
  
  :global(body nav a:hover), :global(body .nav-item:hover) {
    color: #8B2020 !important;
  }
</style>
