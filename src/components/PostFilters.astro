---
interface Props {
  categories: string[];
  allTags: string[];
}

const { categories, allTags } = Astro.props;
---

<!-- Filter and Search Header (Aside) -->
<aside class="mb-8 p-6 rounded-2xl border border-earth/10 bg-paper/30 lg:sticky lg:top-24 space-y-6">
  <div class="flex flex-col gap-6">
    <!-- Search Input -->
    <div class="space-y-2">
      <label for="post-search" class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase block">Search</label>
      <div class="relative">
        <input 
          type="text" 
          id="post-search" 
          placeholder="Search articles..." 
          class="w-full px-4 py-2 text-sm font-sans rounded-xl bg-paper/50 border border-earth/15 text-ink placeholder:text-ink/40 focus:outline-none focus:border-clay/60 transition-colors duration-300"
        />
      </div>
    </div>

    <!-- Categories Filter -->
    {categories.length > 0 && (
      <div class="space-y-2">
        <p class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase">Categories</p>
        <div class="flex flex-wrap gap-2">
          <button 
            data-category-btn="all"
            class="category-btn active px-3 py-1.5 rounded-lg text-xs font-sans font-medium bg-clay/10 text-clay transition-all duration-300 hover:bg-clay/15"
          >
            All Categories
          </button>
          {categories.map(cat => (
            <button 
              data-category-btn={cat}
              class="category-btn px-3 py-1.5 rounded-lg text-xs font-sans text-earth hover:text-clay hover:bg-paper/50 transition-all duration-300"
            >
              {cat}
            </button>
          ))}
        </div>
      </div>
    )}
  </div>

  <!-- Tags Cloud -->
  {allTags.length > 0 && (
    <div class="space-y-2 pt-4 border-t border-earth/10">
      <p class="font-sans text-[10px] font-bold tracking-[0.2em] text-[#c07c64] uppercase">Popular Tags</p>
      <div class="flex flex-wrap gap-1.5">
        {allTags.map(tag => (
          <button 
            data-tag-btn={tag}
            class="tag-btn text-xs font-sans px-2.5 py-1 bg-paper/30 hover:bg-paper/60 border border-earth/10 text-earth-soft hover:text-clay hover:border-clay rounded-md transition-all duration-300"
          >
            #{tag}
          </button>
        ))}
      </div>
    </div>
  )}
</aside>
