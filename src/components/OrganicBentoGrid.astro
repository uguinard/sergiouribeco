---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    eyebrow: "Sergio Uribe Guinard",
    headline: "IB-Certified Educator | Spanish & EAL Specialist",
    subheadline: "Bridging academic rigor with holistic well-being. Designing inquiry-based, 4E Cognition language pipelines for global international school communities.",
    badges: ["IB Certified", "EAL & Humanities", "Spanish MFL & DELE", "EdTech Innovator"],
    cta1: "Explore My IB & EAL Experience",
    cta2: "Download Credentials",
    
    // Cards
    card1Title: "Global Communicator",
    card1Sub: "Academic Core & Languages",
    card1Reveal: "Master’s in Spanish ELE & IB-Certified. From scaffolding EAL literacy to leading DELE exam centres, I build language acquisition frameworks rooted in Conceptual Metaphor Theory and 4E Cognition.",
    
    card2Title: "Ubuntu Thinking",
    card2Sub: "Philosophy & SEL Integration",
    card2Reveal: "Relationships over rules. Restoration over punishment. I prioritize somatic emotional support and restorative circles to create safe, co-created international school communities.",
    
    card3Title: "The EdTech Maker",
    card3Sub: "Tech & Maker Mindset",
    card3Reveal: "I don't just use resources; I build them. Leveraging Python, H5P, and AI to create custom, interactive digital pipelines tailored to the multilingual students in front of me.",
    
    card4Title: "The Observer",
    card4Sub: "Roots & Amazonian Unlearning",
    card4Reveal: "1,200km cycling through the Andes. Teaching in the Amazonian watershed. I bring the 'beginner's mind' to the classroom, decentering authority to let student inquiry and nature lead."
  },
  es: {
    eyebrow: "Sergio Uribe Guinard",
    headline: "Educador Certificado IB | Especialista en Español y EAL",
    subheadline: "Vinculando el rigor académico con el bienestar holístico. Diseñando pipelines de lenguaje basados en indagación y Cognición 4E para comunidades de colegios internacionales.",
    badges: ["Certificado IB", "EAL y Humanidades", "Español MFL y DELE", "Innovador EdTech"],
    cta1: "Explorar mi Experiencia IB y EAL",
    cta2: "Descargar Credenciales",
    
    // Cards
    card1Title: "Comunicador Global",
    card1Sub: "Núcleo Académico y Lenguas",
    card1Reveal: "Máster en ELE y Certificado IB. Desde el andamiaje de la lectoescritura EAL hasta la dirección de centros de examen DELE, diseño marcos de adquisición basados en la Teoría de la Metáfora Conceptual y Cognición 4E.",
    
    card2Title: "Pensamiento Ubuntu",
    card2Sub: "Filosofía e Integración SEL",
    card2Reveal: "Relaciones sobre reglas. Restauración sobre castigo. Priorizo el soporte emocional somático y los círculos restaurativos para cocrear comunidades escolares internacionales seguras.",
    
    card3Title: "El Creador EdTech",
    card3Sub: "Tecnología y Enfoque Maker",
    card3Reveal: "No solo uso recursos; los construyo. Utilizo Python, H5P e IA para crear pipelines digitales interactivos y personalizados a la medida de los estudiantes multilingües frente a mí.",
    
    card4Title: "El Observador",
    card4Sub: "Raíces y Desaprendizaje Amazónico",
    card4Reveal: "1,200 km de ciclismo por los Andes. Enseñando en la cuenca amazónica. Aporto la 'mente de principiante' al aula, descentralizando la autoridad para dejar que la indagación del estudiante y la naturaleza guíen."
  }
};

const t = content[lang] || content.en;
---

<div 
  class="organic-bento-container w-full py-4 animate-fade-in-up"
  x-data="{ 
    activeCard: null, 
    earthyTheme: false,
    toggleTheme() {
      this.earthyTheme = !this.earthyTheme;
      if (this.earthyTheme) {
        document.body.classList.add('earthy-mode');
      } else {
        document.body.classList.remove('earthy-mode');
      }
    }
  }"
>
  <!-- Earthy Mode Toggle (Visual Polish) -->
  <div class="flex justify-end mb-6">
    <button 
      @click="toggleTheme()" 
      class="flex items-center gap-2 px-4 py-2 rounded-full border border-earth/20 bg-paper/60 backdrop-blur-md text-[10px] font-sans font-bold tracking-widest uppercase hover:bg-earth hover:text-paper transition-all duration-300 shadow-sm cursor-pointer"
      :class="earthyTheme ? 'border-emerald-500/30 bg-emerald-950/40 text-emerald-300 hover:bg-emerald-500 hover:text-emerald-950' : ''"
    >
      <span class="w-1.5 h-1.5 rounded-full bg-clay animate-pulse" :class="earthyTheme ? 'bg-emerald-400' : ''"></span>
      <span x-text="earthyTheme ? 'Earthy Forest Mode' : 'Clean Sand Mode'">Clean Sand Mode</span>
    </button>
  </div>

  <!-- Bento Grid Container -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
    
    <!-- Left Panel: Cinematic Video, Credentials & Badges (Spans 7 columns) -->
    <div class="lg:col-span-7 flex flex-col justify-between p-6 md:p-8 rounded-3xl border border-earth/10 bg-paper/30 backdrop-blur-md shadow-lg transition-all duration-500 hover:shadow-2xl hover:border-earth/20 relative overflow-hidden group min-h-[500px]">
      
      <!-- Ambient Glow Background -->
      <div class="absolute -top-24 -left-24 w-48 h-48 rounded-full bg-clay/5 blur-3xl pointer-events-none group-hover:bg-clay/10 transition-all duration-700"></div>
      
      <div class="relative z-10 mb-6">
        <span class="font-sans font-bold text-[10px] tracking-[0.3em] uppercase text-clay" :class="earthyTheme ? 'text-emerald-400' : ''">
          {t.eyebrow}
        </span>
        
        <!-- Headline -->
        <h1 class="font-serif text-3xl md:text-4xl text-ink mt-2 mb-3 leading-tight font-medium" :class="earthyTheme ? 'text-emerald-50' : ''">
          {t.headline}
        </h1>
        
        <!-- Subheadline -->
        <p class="font-serif italic text-sm md:text-base text-ink-light max-w-xl leading-relaxed mb-5" :class="earthyTheme ? 'text-emerald-200/80' : ''">
          {t.subheadline}
        </p>

        <!-- Minimalist Credential Badges -->
        <div class="flex flex-wrap gap-2 mb-2">
          {t.badges.map((badge) => (
            <span class="px-3.5 py-1.5 rounded-full border border-earth/15 bg-paper/80 font-sans font-bold text-[9px] tracking-wider uppercase text-ink-light hover:border-clay/50 hover:text-clay transition-all duration-300" :class="earthyTheme ? 'border-emerald-800/40 bg-emerald-950/40 text-emerald-300' : ''">
              {badge}
            </span>
          ))}
        </div>
      </div>

      <!-- Video Container -->
      <div class="relative w-full aspect-video rounded-2xl overflow-hidden shadow-2xl border border-earth/15 group-hover:border-clay/30 transition-all duration-500 bg-black">
        <iframe 
          class="absolute inset-0 w-full h-full"
          src="https://www.youtube.com/embed/AusbshtWUnE" 
          title="Sergio Uribe Guinard - Introduction" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- Right Panel: Bento Cards (Spans 5 columns) -->
    <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-6">
      
      <!-- Card 1: Global Communicator (IB & Languages) -->
      <div 
        @mouseenter="activeCard = 1" 
        @mouseleave="activeCard = null"
        @click="activeCard = (activeCard === 1 ? null : 1)"
        class="bento-card group flex flex-col justify-between p-6 rounded-3xl border border-earth/10 bg-paper/50 backdrop-blur-md shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg cursor-pointer overflow-hidden relative min-h-[200px]"
        :class="[
          activeCard === 1 ? 'border-clay bg-paper/90 ring-1 ring-clay/20' : '',
          earthyTheme ? 'border-emerald-800/40 bg-emerald-950/20 hover:border-emerald-500/40' : ''
        ]"
      >
        <!-- Custom visual: Globe + Speak vector outline -->
        <svg class="absolute right-4 top-4 w-20 h-20 pointer-events-none opacity-15 group-hover:opacity-30 transition-opacity duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253m0 0L7 8.5" />
        </svg>

        <div class="relative z-10">
          <span class="font-mono text-[10px] tracking-widest uppercase text-earth" :class="earthyTheme ? 'text-emerald-400' : ''">
            [ 01 / CORE ACADEMICS ]
          </span>
          <h2 class="font-serif text-xl text-ink mt-2 mb-1" :class="earthyTheme ? 'text-emerald-50' : ''">
            {t.card1Title}
          </h2>
          <p class="font-sans text-[10px] font-bold tracking-wider uppercase text-clay" :class="earthyTheme ? 'text-emerald-400' : ''">
            {t.card1Sub}
          </p>
        </div>

        <!-- Reveal Content -->
        <div class="relative z-10 mt-4 overflow-hidden transition-all duration-500 max-h-0 group-hover:max-h-24" :class="activeCard === 1 ? 'max-h-24' : ''">
          <p class="font-serif italic text-xs md:text-sm text-ink-light leading-relaxed border-l border-clay/40 pl-3" :class="earthyTheme ? 'text-emerald-200/90 border-emerald-400' : ''">
            "{t.card1Reveal}"
          </p>
        </div>
      </div>

      <!-- Card 2: Ubuntu Thinking (Philosophy & SEL) -->
      <div 
        @mouseenter="activeCard = 2" 
        @mouseleave="activeCard = null"
        @click="activeCard = (activeCard === 2 ? null : 2)"
        class="bento-card group flex flex-col justify-between p-6 rounded-3xl border border-earth/10 bg-paper/50 backdrop-blur-md shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg cursor-pointer overflow-hidden relative min-h-[200px]"
        :class="[
          activeCard === 2 ? 'border-clay bg-paper/90 ring-1 ring-clay/20' : '',
          earthyTheme ? 'border-emerald-800/40 bg-emerald-950/20 hover:border-emerald-500/40' : ''
        ]"
      >
        <!-- Visual: Breathing/overlapping rings -->
        <div class="absolute right-4 top-4 w-20 h-20 pointer-events-none opacity-20 group-hover:opacity-40 transition-opacity duration-500 flex items-center justify-center">
          <div class="absolute w-10 h-10 rounded-full border border-clay animate-ping"></div>
          <div class="absolute w-14 h-14 rounded-full border border-earth/50 mix-blend-multiply" :class="earthyTheme ? 'border-emerald-400' : ''"></div>
          <div class="absolute w-14 h-14 rounded-full border border-clay/50 mix-blend-screen translate-x-3"></div>
        </div>

        <div class="relative z-10">
          <span class="font-mono text-[10px] tracking-widest uppercase text-earth" :class="earthyTheme ? 'text-emerald-400' : ''">
            [ 02 / PHILOSOPHY ]
          </span>
          <h2 class="font-serif text-xl text-ink mt-2 mb-1" :class="earthyTheme ? 'text-emerald-50' : ''">
            {t.card2Title}
          </h2>
          <p class="font-sans text-[10px] font-bold tracking-wider uppercase text-clay" :class="earthyTheme ? 'text-emerald-400' : ''">
            {t.card2Sub}
          </p>
        </div>

        <!-- Reveal Content -->
        <div class="relative z-10 mt-4 overflow-hidden transition-all duration-500 max-h-0 group-hover:max-h-24" :class="activeCard === 2 ? 'max-h-24' : ''">
          <p class="font-serif italic text-xs md:text-sm text-ink-light leading-relaxed border-l border-clay/40 pl-3" :class="earthyTheme ? 'text-emerald-200/90 border-emerald-400' : ''">
            "{t.card2Reveal}"
          </p>
        </div>
      </div>

    </div>
  </div>

  <!-- Bottom Row: 2 wide Bento Cards -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-6">
    
    <!-- Card 3: The EdTech Maker -->
    <div 
      @mouseenter="activeCard = 3" 
      @mouseleave="activeCard = null"
      @click="activeCard = (activeCard === 3 ? null : 3)"
      class="bento-card group flex flex-col justify-between p-6 rounded-3xl border border-earth/10 bg-paper/50 backdrop-blur-md shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg cursor-pointer overflow-hidden relative min-h-[200px]"
      :class="[
        activeCard === 3 ? 'border-clay bg-paper/90 ring-1 ring-clay/20' : '',
        earthyTheme ? 'border-emerald-800/40 bg-emerald-950/20 hover:border-emerald-500/40' : ''
      ]"
    >
      <!-- Visual Element: Code Mockup morphing into Blooming icon -->
      <div class="absolute right-6 top-6 pointer-events-none transition-all duration-500 flex flex-col gap-1 items-end">
        <div class="font-mono text-[7px] text-earth/40 bg-sand/40 p-2 rounded border border-earth/10 group-hover:opacity-0 group-hover:-translate-y-2 transition-all duration-500">
          <span class="text-clay">class</span> <span class="text-ink font-bold">EdTech</span>:<br/>
          &nbsp;&nbsp;<span class="text-earth">def scaffold(learner)</span>
        </div>
        <div class="absolute top-0 right-0 opacity-0 scale-50 group-hover:opacity-100 group-hover:scale-100 transition-all duration-500 flex items-center justify-center w-10 h-10">
          <svg class="w-7 h-7 text-emerald-600 animate-pulse" :class="earthyTheme ? 'text-emerald-400' : ''" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v18M3 12h18M12 3c-2.4 0-4.5 1.5-5.5 3.5m5.5-3.5c2.4 0 4.5 1.5 5.5 3.5M12 21c-2.4 0-4.5-1.5-5.5-3.5m5.5 3.5c2.4 0 4.5-1.5 5.5-3.5M6.5 6.5l11 11" />
          </svg>
        </div>
      </div>

      <div class="relative z-10 max-w-[80%]">
        <span class="font-mono text-[10px] tracking-widest uppercase text-earth" :class="earthyTheme ? 'text-emerald-400' : ''">
          [ 03 / DIGITAL PIPELINES ]
        </span>
        <h2 class="font-serif text-xl text-ink mt-2 mb-1" :class="earthyTheme ? 'text-emerald-50' : ''">
          {t.card3Title}
        </h2>
        <p class="font-sans text-[10px] font-bold tracking-wider uppercase text-clay" :class="earthyTheme ? 'text-emerald-400' : ''">
          {t.card3Sub}
        </p>
      </div>

      <!-- Reveal Content -->
      <div class="relative z-10 mt-4 overflow-hidden transition-all duration-500 max-h-0 group-hover:max-h-24" :class="activeCard === 3 ? 'max-h-24' : ''">
        <p class="font-serif italic text-xs md:text-sm text-ink-light leading-relaxed border-l border-clay/40 pl-3" :class="earthyTheme ? 'text-emerald-200/90 border-emerald-400' : ''">
          "{t.card3Reveal}"
        </p>
      </div>
    </div>

    <!-- Card 4: The Observer (Roots & Unlearning) -->
    <div 
      @mouseenter="activeCard = 4" 
      @mouseleave="activeCard = null"
      @click="activeCard = (activeCard === 4 ? null : 4)"
      class="bento-card group flex flex-col justify-between p-6 rounded-3xl border border-earth/10 bg-paper/50 backdrop-blur-md shadow-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-lg cursor-pointer overflow-hidden relative min-h-[200px]"
      :class="[
        activeCard === 4 ? 'border-clay bg-paper/90 ring-1 ring-clay/20' : '',
        earthyTheme ? 'border-emerald-800/40 bg-emerald-950/20 hover:border-emerald-500/40' : ''
      ]"
    >
      <!-- Visual: Topographical winding curve animation -->
      <svg class="absolute right-4 top-4 w-28 h-20 pointer-events-none opacity-20 group-hover:opacity-50 transition-all duration-500" viewBox="0 0 100 60" fill="none">
        <path 
          d="M10,50 C30,45 20,20 40,30 C60,40 50,10 70,20 C90,30 80,5 95,10" 
          stroke="var(--color-clay, #C07C64)" 
          stroke-width="1.2" 
          stroke-linecap="round"
          class="topographic-path"
        />
        <path 
          d="M5,52 C25,48 15,22 35,32 C55,42 45,12 65,22 C85,32 75,7 90,12" 
          stroke="var(--color-earth, #8C7B6A)" 
          stroke-width="0.5" 
          stroke-dasharray="2 2"
        />
      </svg>

      <div class="relative z-10 max-w-[80%]">
        <span class="font-mono text-[10px] tracking-widest uppercase text-earth" :class="earthyTheme ? 'text-emerald-400' : ''">
          [ 04 / ENQUIRY & ROOTS ]
        </span>
        <h2 class="font-serif text-xl text-ink mt-2 mb-1" :class="earthyTheme ? 'text-emerald-50' : ''">
          {t.card4Title}
        </h2>
        <p class="font-sans text-[10px] font-bold tracking-wider uppercase text-clay" :class="earthyTheme ? 'text-emerald-400' : ''">
          {t.card4Sub}
        </p>
      </div>

      <!-- Reveal Content -->
      <div class="relative z-10 mt-4 overflow-hidden transition-all duration-500 max-h-0 group-hover:max-h-24" :class="activeCard === 4 ? 'max-h-24' : ''">
        <p class="font-serif italic text-xs md:text-sm text-ink-light leading-relaxed border-l border-clay/40 pl-3" :class="earthyTheme ? 'text-emerald-200/90 border-emerald-400' : ''">
          "{t.card4Reveal}"
        </p>
      </div>
    </div>

  </div>

  <!-- Dual Button Call to Action Footer -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-12 w-full max-w-xl mx-auto">
    <!-- CTA Button 1: Experience CV -->
    <a 
      href={`/${lang === 'en' ? '' : lang + '/'}cv`}
      class="w-full sm:w-auto group relative flex items-center justify-center gap-3.5 px-7 py-4 rounded-full border border-earth/20 bg-paper/85 text-xs font-sans font-bold tracking-widest text-ink uppercase transition-all duration-500 hover:text-paper hover:bg-earth shadow-md cursor-pointer hover:shadow-xl hover:-translate-y-0.5 overflow-hidden text-center"
      :class="earthyTheme ? 'border-emerald-500/20 bg-emerald-950/40 text-emerald-100 hover:bg-emerald-700 hover:text-paper' : ''"
    >
      <span class="absolute inset-0 w-full h-full bg-gradient-to-r from-clay to-earth opacity-0 group-hover:opacity-10 transition-opacity duration-500 pointer-events-none"></span>
      {t.cta1}
      <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>

    <!-- CTA Button 2: Download Credentials (links to a PDF path, can be custom file uploaded or placeholders) -->
    <a 
      href="/cv" 
      class="w-full sm:w-auto group relative flex items-center justify-center gap-3.5 px-7 py-4 rounded-full border border-earth/15 bg-transparent text-xs font-sans font-bold tracking-widest text-ink-light uppercase transition-all duration-500 hover:border-clay hover:text-clay cursor-pointer shadow-sm hover:shadow-md hover:-translate-y-0.5 text-center"
      :class="earthyTheme ? 'border-emerald-800 text-emerald-200 hover:border-emerald-400 hover:text-emerald-400' : ''"
    >
      <svg class="w-4 h-4 text-clay group-hover:animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
      </svg>
      {t.cta2}
    </a>
  </div>
</div>

<style>
  /* Perpetual topo path draw animation */
  .topographic-path {
    stroke-dasharray: 200;
    stroke-dashoffset: 200;
    animation: draw-path 9s linear infinite;
  }

  @keyframes draw-path {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Smooth dynamic hover transition */
  .bento-card {
    transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Theme adjustments */
  :global(body.earthy-mode) {
    background-color: #0b1a10 !important;
    color: #ecfdf5 !important;
  }
  :global(body.earthy-mode header) {
    background-color: rgba(11, 26, 16, 0.8) !important;
    border-color: rgba(16, 185, 129, 0.1) !important;
  }
  :global(body.earthy-mode nav a), :global(body.earthy-mode .nav-item) {
    color: #a7f3d0 !important;
  }
  :global(body.earthy-mode nav a:hover), :global(body.earthy-mode .nav-item:hover) {
    color: #34d399 !important;
  }
  :global(body.earthy-mode footer) {
    border-color: rgba(16, 185, 129, 0.2) !important;
    color: #6ee7b7 !important;
  }
</style>
