---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    eyebrow: "IB-Certified Language Educator • Spanish, English & French",
    title: "Sergio Uribe Guinard",
    location: "Đà Nẵng, Vietnam",
    manifesto: "I teach Spanish by letting students live it. Language is not a subject to memorise — it is a way to move through the world with other people.",
    bioParagraph: "Holistic language educator. Colombian by origin, shaped by four continents. Grounded in 4E Cognition, comprehensible input, and the belief that the most important things happen between people.",
    credentials: [
      { label: "IB Certified", icon: "◆" },
      { label: "M.A. ELE · Univ. of Seville", icon: "◆" },
      { label: "B.A. in Foreign Languages", icon: "◆" },
      { label: "Cognitive Linguistics", icon: "◆" },
    ],
    cta1: "View Full CV",
    cta2: "Read My Philosophy",
    tags: [
      {
        text: "4E Cognition",
        tooltip: "Language is a physical event. My Master's thesis (University of Seville, 2024) applied this framework: learning is Embodied, Enacted, Embedded, and Extended. It transforms grammar from abstract syntax rules into bodily, spatial, and relational actions.",
        position: "top-left",
        float: "float-a",
        accent: true,
      },
      {
        text: "Comprehensible Input",
        tooltip: "Rooted in Krashen's i+1 hypothesis. Acquisition happens when input is understood. I design context-rich environments using multimodal cues, imagery, and interactive digital scaffolding so students absorb language without translation anxiety.",
        position: "top-right",
        float: "float-b",
      },
      {
        text: "Ubuntu Thinking",
        tooltip: "'I am because we are.' Grounded in my Colombian roots, I believe learning happens in the space between people. The classroom is built on relational safety, mutual agency, and co-creating knowledge as a supportive community.",
        position: "mid-left",
        float: "float-c",
        accent: true,
      },
      {
        text: "Cognitive Linguistics",
        tooltip: "Grounded in Conceptual Metaphor Theory. Language is not processed in isolation; it maps directly to sensory and somatic schemas in the brain. Storytelling and conceptual mappings ensure vocabulary anchors deeply in the mind.",
        position: "mid-right",
        float: "float-d",
        accent: true,
      },
      {
        text: "Restorative Circles",
        tooltip: "Moving from behavioral compliance to emotional growth. I use structured circles to resolve classroom conflicts, check in on well-being, and establish a culture of listening and trust, refined in Thailand and Turkey.",
        position: "low-left",
        float: "float-a",
      },
      {
        text: "Beginner's Mind",
        tooltip: "Arriving without rigid assumptions. Whether cycling 1,200 km solo across Turkey or greeting a class in Vietnam, I cultivate the openness needed to truly observe, listen, and learn alongside my students.",
        position: "low-right",
        float: "float-b",
      },
      {
        text: "EdTech Maker",
        tooltip: "Technology at the service of human connection. I code custom Python workflows, interactive H5P modules, and digital assets. This approach generated a documented 40% participation boost at Tarsus American College.",
        position: "bottom-center",
        float: "float-c",
      },
    ],
    experience: [
      { place: "UWC Thailand", role: "IB Spanish · EAL · Outdoor Ed · Year 6 Co-Director", flag: "🇹🇭" },
      { place: "Tarsus American College", role: "IB Spanish · DELE Accreditation Lead", flag: "🇹🇷" },
      { place: "Guainía, Colombia", role: "Spanish & Community Ed · Remote Territory", flag: "🇨🇴" },
    ],
  },
  es: {
    eyebrow: "Educador Certificado IB • Español, Inglés y Francés",
    title: "Sergio Uribe Guinard",
    location: "Đà Nẵng, Vietnam",
    manifesto: "Enseño español dejando que los estudiantes lo vivan. El lenguaje no es una asignatura para memorizar — es una forma de moverse por el mundo con otras personas.",
    bioParagraph: "Educador holístico de lenguas. Colombiano de origen, formado en cuatro continentes. Fundamentado en la Cognición 4E, el input comprensible y la convicción de que lo más importante ocurre entre personas.",
    credentials: [
      { label: "Certificado IB", icon: "◆" },
      { label: "M.A. ELE · Univ. Sevilla", icon: "◆" },
      { label: "Licenciado en Lenguas", icon: "◆" },
      { label: "Lingüística Cognitiva", icon: "◆" },
    ],
    cta1: "Ver CV Completo",
    cta2: "Leer mi Filosofía",
    tags: [
      {
        text: "Cognición 4E",
        tooltip: "El lenguaje es una acción física. Mi TFM (Universidad de Sevilla, 2024) aplicó este marco: el aprendizaje es Corporizado, Enactivo, Situado y Extendida. Transforma la gramática de reglas abstractas a acciones relacionales y corporales.",
        position: "top-left",
        float: "float-a",
        accent: true,
      },
      {
        text: "Input Comprensible",
        tooltip: "Basado en la hipótesis i+1 de Krashen. Adquirimos cuando comprendemos. Diseño entornos con andamiaje visual, gestual y digital para que el alumno absorba la lengua de forma natural sin ansiedad de traducción.",
        position: "top-right",
        float: "float-b",
      },
      {
        text: "Pensamiento Ubuntu",
        tooltip: "'Soy porque somos.' Inspirado en mis raíces comunitarias colombianas, creo que el aprendizaje ocurre en la relación con el otro. Construyo aulas basadas en la seguridad afectiva y la agencia compartida.",
        position: "mid-left",
        float: "float-c",
        accent: true,
      },
      {
        text: "Lingüística Cognitiva",
        tooltip: "Basado en la Teoría de la Metáfora Conceptual. El lenguaje no se procesa de forma aislada; se asocia directamente a esquemas sensoriales y somáticos en el cerebro. La narrativa y los mapeos conceptuales aseguran una retención profunda.",
        position: "mid-right",
        float: "float-d",
        accent: true,
      },
      {
        text: "Círculos Restaurativos",
        tooltip: "Pasar de la disciplina punitiva al desarrollo emocional. Utilizo círculos estructurados para resolver conflictos en el aula, indagar sobre el bienestar y crear un espacio seguro de escucha empática.",
        position: "low-left",
        float: "float-a",
      },
      {
        text: "Mente de Principiante",
        tooltip: "Llegar sin suposiciones preestablecidas. Sea pedaleando 1.200 km solo por Turquía o al entrar a un aula en Vietnam, cultivo la apertura para escuchar activamente y aprender junto a mis alumnos.",
        position: "low-right",
        float: "float-b",
      },
      {
        text: "Creador EdTech",
        tooltip: "Tecnología al servicio de las relaciones humanas. Programo herramientas en Python, módulos interactivos H5P y recursos digitales que lograron un aumento documentado del 40% en participación en Tarsus.",
        position: "bottom-center",
        float: "float-c",
      },
    ],
    experience: [
      { place: "UWC Thailand", role: "IB Español · EAL · Ed. Exterior · Co-Director Año 6", flag: "🇹🇭" },
      { place: "Tarsus American College", role: "IB Español · Director Acreditación DELE", flag: "🇹🇷" },
      { place: "Guainía, Colombia", role: "Español y Ed. Comunitaria · Territorio Remoto", flag: "🇨🇴" },
    ],
  },
};

const t = content[lang] || content.en;
---

<section class="orbital-root" aria-label="Introduction">

  <!-- ═══════════════════════════════════════════════════
       HEADER — Title Role
  ═══════════════════════════════════════════════════ -->
  <header class="orbital-header">
    <div class="inline-flex items-center gap-2 mb-3">
      <span class="badge-pulse-dot"></span>
      <span class="text-xs uppercase tracking-widest font-sans font-semibold text-earth">Active Pedagogy & Research</span>
    </div>
    <h1 class="main-page-title">{t.eyebrow}</h1>
  </header>

  <!-- ═══════════════════════════════════════════════════
       CREDENTIAL PILLS
  ═══════════════════════════════════════════════════ -->
  <div class="credential-strip" role="list" aria-label="Credentials">
    {t.credentials.map(c => (
      <span class="cred-pill" role="listitem">
        <span class="cred-icon" aria-hidden="true">{c.icon}</span>
        {c.label}
      </span>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════
       ORBITAL STAGE — Video + Floating Tags
  ═══════════════════════════════════════════════════ -->
  <div class="orbital-stage" role="region" aria-label="Pedagogical Constellation">

    <!-- Tag: top-left -->
    <div class="tag-wrapper tag-top-left">
      <div class={`orbital-tag-group ${t.tags[0].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[0].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-0"
          type="button"
        >
          {t.tags[0].text}
        </button>
        <span id="tooltip-0" class="tag-tooltip" role="tooltip">{t.tags[0].tooltip}</span>
      </div>
    </div>

    <!-- Tag: top-right -->
    <div class="tag-wrapper tag-top-right">
      <div class={`orbital-tag-group ${t.tags[1].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[1].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-1"
          type="button"
        >
          {t.tags[1].text}
        </button>
        <span id="tooltip-1" class="tag-tooltip" role="tooltip">{t.tags[1].tooltip}</span>
      </div>
    </div>

    <!-- Central Video -->
    <div class="video-core" aria-label="Introduction video">
      <div class="video-glow-ring" aria-hidden="true"></div>
      <div class="video-frame">
        <div class="video-aspect">
          <iframe
            src="https://www.youtube.com/embed/AusbshtWUnE?rel=0&modestbranding=1"
            title="Sergio Uribe Guinard — Introduction"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
      </div>
    </div>

    <!-- Tag: mid-left -->
    <div class="tag-wrapper tag-mid-left">
      <div class={`orbital-tag-group ${t.tags[2].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[2].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-2"
          type="button"
        >
          {t.tags[2].text}
        </button>
        <span id="tooltip-2" class="tag-tooltip" role="tooltip">{t.tags[2].tooltip}</span>
      </div>
    </div>

    <!-- Tag: mid-right -->
    <div class="tag-wrapper tag-mid-right">
      <div class={`orbital-tag-group ${t.tags[3].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[3].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-3"
          type="button"
        >
          {t.tags[3].text}
        </button>
        <span id="tooltip-3" class="tag-tooltip" role="tooltip">{t.tags[3].tooltip}</span>
      </div>
    </div>

    <!-- Tag: low-left -->
    <div class="tag-wrapper tag-low-left">
      <div class={`orbital-tag-group ${t.tags[4].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[4].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-4"
          type="button"
        >
          {t.tags[4].text}
        </button>
        <span id="tooltip-4" class="tag-tooltip" role="tooltip">{t.tags[4].tooltip}</span>
      </div>
    </div>

    <!-- Tag: low-right -->
    <div class="tag-wrapper tag-low-right">
      <div class={`orbital-tag-group ${t.tags[5].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[5].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-5"
          type="button"
        >
          {t.tags[5].text}
        </button>
        <span id="tooltip-5" class="tag-tooltip" role="tooltip">{t.tags[5].tooltip}</span>
      </div>
    </div>

    <!-- Tag: bottom-center -->
    <div class="tag-wrapper tag-bottom-center">
      <div class={`orbital-tag-group ${t.tags[6].float}`} style="position: relative;">
        <button
          class={`orbital-tag ${t.tags[6].accent ? 'tag-accent' : ''}`}
          aria-describedby="tooltip-6"
          type="button"
        >
          {t.tags[6].text}
        </button>
        <span id="tooltip-6" class="tag-tooltip" role="tooltip">{t.tags[6].tooltip}</span>
      </div>
    </div>

  </div>

  <!-- ═══════════════════════════════════════════════════
       MANIFESTO — Prose & Readability
  ═══════════════════════════════════════════════════ -->
  <div class="manifesto-block glass-card">
    <p class="manifesto-lead">{t.manifesto}</p>
    <p class="manifesto-body">{t.bioParagraph}</p>
  </div>

  <!-- ═══════════════════════════════════════════════════
       EXPERIENCE STRIP — Glassmorphic Cards
  ═══════════════════════════════════════════════════ -->
  <div class="experience-strip" role="list" aria-label="Teaching experience">
    {t.experience.map(e => (
      <div class="exp-card glass-card" role="listitem">
        <span class="exp-flag" aria-hidden="true">{e.flag}</span>
        <div class="exp-text">
          <strong class="exp-place">{e.place}</strong>
          <span class="exp-role">{e.role}</span>
        </div>
      </div>
    ))}
  </div>

  <!-- ═══════════════════════════════════════════════════
       CTA BUTTONS
  ═══════════════════════════════════════════════════ -->
  <div class="cta-row">
    <a
      href={`/${lang === 'en' ? '' : lang + '/'}cv`}
      class="cta-primary"
      id="cta-cv"
    >
      {t.cta1}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </a>
    <a
      href={`/${lang === 'en' ? '' : lang + '/'}philosophy`}
      class="cta-ghost"
      id="cta-philosophy"
    >
      {t.cta2}
    </a>
  </div>

</section>

<style>
  /* ═══════════════════════════════════════════════════
     DESIGN TOKENS
  ═══════════════════════════════════════════════════ */
  .orbital-root {
    --sand:    #F7F4EE;
    --ink:     #1C1A17;
    --ink-60:  rgba(28, 26, 23, 0.6);
    --ink-20:  rgba(28, 26, 23, 0.12);
    --forest:  #162e1c;
    --forest-20: rgba(22, 46, 28, 0.18);
    --clay:    #C07C64;
    --clay-20: rgba(192, 124, 100, 0.18);

    /* Video sizing */
    --video-w: min(440px, 90vw);

    /* Orbit offset — how far tags sit from the video edge */
    --orbit-x: 15%;
    --orbit-y: 14%;

    padding: 2rem 0 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  /* ═══════════════════════════════════════════════════
     HEADER
  ═══════════════════════════════════════════════════ */
  .orbital-header {
    text-align: center;
    padding-bottom: 2rem;
    margin-bottom: 2.2rem;
    border-bottom: 1px solid var(--ink-20);
    width: 100%;
  }

  .main-page-title {
    font-family: 'Lora', serif;
    font-size: clamp(1.6rem, 4.5vw, 2.6rem);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--forest);
    margin: 0;
  }

  /* ═══════════════════════════════════════════════════
     CREDENTIAL PILLS
  ═══════════════════════════════════════════════════ */
  .credential-strip {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin-bottom: 2.5rem;
  }

  .cred-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--ink-20);
    background: transparent;
    font-family: 'Albert Sans', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
    transition: border-color 0.25s, color 0.25s;
  }

  .cred-pill:hover {
    border-color: var(--clay);
    color: var(--clay);
  }

  .cred-icon {
    font-size: 0.55rem;
    color: var(--clay);
    line-height: 1;
  }

  /* ═══════════════════════════════════════════════════
     ORBITAL STAGE
     Grid-based layout: video is centered,
     tag-wrappers occupy named grid areas.
  ═══════════════════════════════════════════════════ */
  .orbital-stage {
    position: relative;
    width: 100%;
    max-width: 900px;
    margin: 0 auto 3rem;

    /* On desktop, build a 3-column grid: left tags | video | right tags */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    grid-template-rows: auto auto auto auto auto;
    align-items: center;
    gap: 0.75rem 1.5rem;
    grid-template-areas:
      "tl  .    tr"
      "ml  vid  mr"
      "ll  vid  lr"
      ".   vid  ."
      ".   bc   .";
  }

  /* Video */
  .video-core {
    grid-area: vid;
    position: relative;
    width: var(--video-w);
    flex-shrink: 0;
  }

  /* Outer animated glow ring */
  .video-glow-ring {
    position: absolute;
    inset: -6px;
    border-radius: 1.75rem;
    border: 1px solid var(--forest-20);
    pointer-events: none;
    animation: ring-pulse 5s ease-in-out infinite alternate;
    z-index: 0;
  }

  @keyframes ring-pulse {
    0%   { box-shadow: 0 0 20px 2px rgba(22,46,28,0.10), 0 0 0 0 rgba(22,46,28,0); }
    100% { box-shadow: 0 0 48px 8px rgba(22,46,28,0.22), 0 0 0 6px rgba(22,46,28,0.04); }
  }

  /* Inner frame */
  .video-frame {
    position: relative;
    z-index: 1;
    border-radius: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--ink-20);
    background: #000;
    box-shadow:
      0 2px 8px rgba(28,26,23,0.08),
      0 8px 32px rgba(28,26,23,0.12),
      0 24px 64px rgba(22,46,28,0.10);
  }

  .video-aspect {
    position: relative;
    width: 100%;
    padding-top: 56.25%; /* 16:9 */
  }

  .video-aspect iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* ─── Tag Wrappers ─── */
  .tag-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .tag-top-left    { grid-area: tl; justify-content: flex-end; }
  .tag-top-right   { grid-area: tr; justify-content: flex-start; }
  .tag-mid-left    { grid-area: ml; justify-content: flex-end; }
  .tag-mid-right   { grid-area: mr; justify-content: flex-start; }
  .tag-low-left    { grid-area: ll; justify-content: flex-end; }
  .tag-low-right   { grid-area: lr; justify-content: flex-start; }
  .tag-bottom-center { grid-area: bc; justify-content: center; }

  /* ─── Orbital Tags ─── */
  .orbital-tag-group {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
  }

  .orbital-tag {
    display: inline-block;
    padding: 0.55rem 1.25rem;
    border-radius: 999px;
    border: 1px solid var(--ink-20);
    background: var(--sand);
    font-family: 'Lora', serif;
    font-size: 0.9rem;
    font-style: italic;
    color: var(--ink);
    cursor: pointer;
    white-space: nowrap;
    transition:
      transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
      border-color 0.3s,
      color 0.3s,
      background 0.3s,
      box-shadow 0.3s;
  }

  .orbital-tag-group:hover,
  .orbital-tag-group:focus-within {
    z-index: 100;
  }

  .orbital-tag-group:hover .orbital-tag,
  .orbital-tag-group:focus-within .orbital-tag {
    transform: scale(1.08) !important;
    border-color: var(--clay);
    color: var(--clay);
    background: var(--sand);
    box-shadow: 0 4px 16px var(--clay-20);
    outline: none;
  }

  .orbital-tag.tag-accent {
    border-color: var(--forest-20);
    color: var(--forest);
  }

  .orbital-tag-group:hover .orbital-tag.tag-accent,
  .orbital-tag-group:focus-within .orbital-tag.tag-accent {
    border-color: var(--clay);
    color: var(--clay);
  }

  /* ─── Tooltip ─── */
  .tag-tooltip {
    position: absolute;
    bottom: calc(100% + 10px);
    left: 50%;
    transform: translateX(-50%) translateY(4px);
    width: 320px;
    padding: 1rem 1.25rem;
    border-radius: 0.75rem;
    background: var(--forest);
    color: var(--sand);
    font-family: 'Albert Sans', sans-serif;
    font-size: 0.8rem;
    font-weight: 400;
    line-height: 1.6;
    letter-spacing: 0.01em;
    font-style: normal;
    white-space: normal;
    text-align: left;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.22s ease, transform 0.22s ease;
    z-index: 50;
    box-shadow: 0 8px 24px rgba(22,46,28,0.25);
    /* Arrow */
    --arrow-size: 6px;
  }

  .tag-tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: var(--arrow-size) solid transparent;
    border-top-color: var(--forest);
  }

  .orbital-tag-group:hover .tag-tooltip,
  .orbital-tag-group:focus-within .tag-tooltip {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  /* Hover pauses the keyframe float animation on the group container */
  .orbital-tag-group:hover {
    animation-play-state: paused !important;
  }

  /* Tags at low positions: open tooltip upward is fine, but bottom-center should open downward */
  .tag-bottom-center .orbital-tag-group .tag-tooltip {
    bottom: auto;
    top: calc(100% + 10px);
    transform: translateX(-50%) translateY(-4px);
  }
  .tag-bottom-center .orbital-tag-group .tag-tooltip::after {
    top: auto;
    bottom: 100%;
    border-top-color: transparent;
    border-bottom-color: var(--forest);
  }
  .tag-bottom-center .orbital-tag-group:hover .tag-tooltip,
  .tag-bottom-center .orbital-tag-group:focus-within .tag-tooltip {
    transform: translateX(-50%) translateY(0);
  }

  /* ─── Float Animations ─── */
  .float-a { animation: floatA 7s ease-in-out infinite alternate; }
  .float-b { animation: floatB 8.5s ease-in-out infinite alternate; }
  .float-c { animation: floatC 6.5s ease-in-out infinite alternate; }
  .float-d { animation: floatD 9s ease-in-out infinite alternate; }

  @keyframes floatA {
    0%   { transform: translateY(0px) rotate(-0.5deg); }
    100% { transform: translateY(-9px) rotate(1deg); }
  }
  @keyframes floatB {
