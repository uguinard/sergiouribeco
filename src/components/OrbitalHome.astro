---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "Language Acquisition & Pedagogical Scaffolding",
    anchorText: "I am a holistic IB educator offering English as an Additional Language and Spanish as a Foreign Language. My practice is grounded in 4E Cognition, weaving together academic rigor with somatic emotional support and restorative community building. I am deeply interested in the intersection of nature and language acquisition, and I am currently open to new international school opportunities, specifically in Central Vietnam.",
    
    // Orbit tags
    tags: [
      { text: "4E Cognition", category: "philosophy", floatClass: "float-1" },
      { text: "Autopoiesis", category: "philosophy", floatClass: "float-2" },
      { text: "Beginner's Mind", category: "philosophy", floatClass: "float-3" },
      { text: "Restorative Circles", category: "philosophy", floatClass: "float-4" },
      { text: "Ubuntu Thinking", category: "philosophy", floatClass: "float-1" },
      { text: "Inquiry-Based Learning", category: "philosophy", floatClass: "float-2" },
      { text: "Dual-Language Architecture", category: "skill", floatClass: "float-3" },
      { text: "EdTech Innovation", category: "skill", floatClass: "float-4" },
      { text: "H5P / Python", category: "skill", floatClass: "float-1" },
      { text: "Academic Literacy", category: "skill", floatClass: "float-2" },
      { text: "Somatic Emotional Support", category: "skill", floatClass: "float-3" }
    ],
    
    cvLink: "Curriculum Vitae ➔",
    pdfLink: "Download Dossier (PDF) ⬇"
  },
  es: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "Adquisición de Lenguas y Andamiaje Pedagógico",
    anchorText: "Soy un educador holístico IB que ofrece Inglés como Lengua Adicional y Español como Lengua Extranjera. Mi práctica se basa en la Cognición 4E, entrelazando el rigor académico con el apoyo socioemocional somático y la construcción de comunidades restaurativas. Estoy profundamente interesado en la intersección de la naturaleza y la adquisición de lenguas, y actualmente estoy abierto a nuevas oportunidades en colegios internacionales, específicamente en el centro de Vietnam.",
    
    tags: [
      { text: "Cognición 4E", category: "philosophy", floatClass: "float-1" },
      { text: "Autopoiesis", category: "philosophy", floatClass: "float-2" },
      { text: "Mente de Principiante", category: "philosophy", floatClass: "float-3" },
      { text: "Círculos Restaurativos", category: "philosophy", floatClass: "float-4" },
      { text: "Pensamiento Ubuntu", category: "philosophy", floatClass: "float-1" },
      { text: "Aprendizaje por Indagación", category: "philosophy", floatClass: "float-2" },
      { text: "Arquitectura de Lenguaje Dual", category: "skill", floatClass: "float-3" },
      { text: "Innovación EdTech", category: "skill", floatClass: "float-4" },
      { text: "H5P / Python", category: "skill", floatClass: "float-1" },
      { text: "Alfabetización Académica", category: "skill", floatClass: "float-2" },
      { text: "Soporte Emocional Somático", category: "skill", floatClass: "float-3" }
    ],
    
    cvLink: "Currículum Vitae ➔",
    pdfLink: "Descargar Dossier (PDF) ⬇"
  }
};

const t = content[lang] || content.en;
---

<div class="orbital-home-container max-w-6xl mx-auto px-6 py-12 text-[#1C1A17] bg-[#F7F4EE]">
  
  <!-- Masthead Header -->
  <header class="border-b border-[#1C1A17]/15 pb-6 mb-12 text-center">
    <h1 class="font-serif text-3xl md:text-5xl font-normal tracking-tight leading-none mb-2">
      {t.title}
    </h1>
    <p class="font-sans text-[10px] md:text-xs font-bold tracking-[0.25em] text-[#8B2020] uppercase">
      {t.subtitle}
    </p>
  </header>

  <!-- The Orbital Stage (Desktop: Absolute relative circles, Mobile: Grid/Tag Cloud) -->
  <div class="relative w-full min-h-[300px] md:min-h-[580px] flex items-center justify-center mb-12 mt-4">
    
    <!-- Central Anchor Video Frame -->
    <div class="w-full max-w-lg z-20 border border-[#1C1A17]/15 p-2 bg-[#F7F4EE] rounded-xl shadow-2xl relative">
      <div class="absolute -top-3 -left-3 w-8 h-8 border-t-2 border-l-2 border-[#8B2020] pointer-events-none"></div>
      <div class="absolute -bottom-3 -right-3 w-8 h-8 border-b-2 border-r-2 border-[#8B2020] pointer-events-none"></div>
      
      <div class="relative w-full aspect-video rounded overflow-hidden bg-black shadow-inner border border-[#1C1A17]/25">
        <iframe 
          class="w-full h-full"
          src="https://www.youtube.com/embed/AusbshtWUnE" 
          title="Sergio Uribe Guinard - Introduction" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <!-- Orbit Tags - Styled dynamically -->
    <!-- Desktop positions absolute, mobile layout relative tag cloud wrap -->
    <div class="absolute md:inset-0 w-full h-full pointer-events-none flex flex-wrap justify-center items-center gap-2.5 mt-8 md:mt-0 relative md:absolute z-10">
      
      <!-- Tag 1 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[0].floatClass} 
        md:absolute md:top-[12%] md:left-[10%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[0].text}
      </span>
      
      <!-- Tag 2 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[1].floatClass} 
        md:absolute md:top-[10%] md:right-[12%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[1].text}
      </span>

      <!-- Tag 3 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[2].floatClass} 
        md:absolute md:top-[42%] md:left-[2%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[2].text}
      </span>

      <!-- Tag 4 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[3].floatClass} 
        md:absolute md:top-[45%] md:right-[2%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[3].text}
      </span>

      <!-- Tag 5 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[4].floatClass} 
        md:absolute md:bottom-[15%] md:left-[8%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[4].text}
      </span>

      <!-- Tag 6 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-xs font-serif transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[5].floatClass} 
        md:absolute md:bottom-[12%] md:right-[10%] border-[#1C1A17]/15 text-[#1C1A17]`}>
        {t.tags[5].text}
      </span>

      <!-- Tag 7 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-[10px] font-mono tracking-wider uppercase transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[6].floatClass} 
        md:absolute md:top-[28%] md:left-[8%] border-[#8B2020]/20 text-[#8B2020]`}>
        {t.tags[6].text}
      </span>

      <!-- Tag 8 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-[10px] font-mono tracking-wider uppercase transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[7].floatClass} 
        md:absolute md:top-[26%] md:right-[6%] border-[#8B2020]/20 text-[#8B2020]`}>
        {t.tags[7].text}
      </span>

      <!-- Tag 9 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-[10px] font-mono tracking-wider uppercase transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[8].floatClass} 
        md:absolute md:bottom-[32%] md:left-[5%] border-[#8B2020]/20 text-[#8B2020]`}>
        {t.tags[8].text}
      </span>

      <!-- Tag 10 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-[10px] font-mono tracking-wider uppercase transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[9].floatClass} 
        md:absolute md:bottom-[30%] md:right-[4%] border-[#8B2020]/20 text-[#8B2020]`}>
        {t.tags[9].text}
      </span>

      <!-- Tag 11 -->
      <span class={`pointer-events-auto cursor-pointer px-4 py-2 rounded-full border bg-[#F7F4EE]/90 backdrop-blur-sm text-[10px] font-mono tracking-wider uppercase transition-all duration-300 hover:scale-105 hover:border-[#8B2020] hover:text-[#8B2020] shadow-sm select-none ${t.tags[10].floatClass} 
        md:absolute md:bottom-[-2%] md:left-[40%] border-[#8B2020]/20 text-[#8B2020]`}>
        {t.tags[10].text}
      </span>

    </div>

  </div>

  <!-- Narrative Anchor Profile Statement -->
  <section class="max-w-3xl mx-auto border-t border-b border-[#1C1A17]/15 py-8 my-12 text-center">
    <p class="font-serif text-sm md:text-base leading-relaxed text-justify md:text-center text-[#1C1A17]/85">
      {t.anchorText}
    </p>
  </section>

  <!-- Footer Actions -->
  <footer class="flex justify-between items-center text-xs">
    <a 
      href={`/${lang === 'en' ? '' : lang + '/'}cv`}
      class="font-sans font-bold tracking-widest text-[#1C1A17] hover:text-[#8B2020] uppercase transition-colors"
    >
      {t.cvLink}
    </a>
    
    <a 
      href="/cv"
      class="font-sans font-bold tracking-widest text-[#8B2020] hover:text-[#1C1A17] uppercase transition-colors"
    >
      {t.pdfLink}
    </a>
  </footer>
</div>

<style>
  /* Floating Breathing CSS Animations */
  .float-1 { animation: float1 6s ease-in-out infinite alternate; }
  .float-2 { animation: float2 5s ease-in-out infinite alternate; }
  .float-3 { animation: float3 7s ease-in-out infinite alternate; }
  .float-4 { animation: float4 5.5s ease-in-out infinite alternate; }

  @keyframes float1 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-10px) rotate(1deg); }
  }
  @keyframes float2 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(8px) rotate(-1.5deg); }
  }
  @keyframes float3 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(-8px) rotate(-1deg); }
  }
  @keyframes float4 {
    0% { transform: translateY(0px) rotate(0deg); }
    100% { transform: translateY(10px) rotate(1.5deg); }
  }

  /* Responsive Adjustments: disable absolute positioning animations on mobile */
  @media (max-width: 767px) {
    .float-1, .float-2, .float-3, .float-4 {
      animation: none !important;
      transform: none !important;
    }
  }

  /* Global variables override */
  :global(body) {
    background-color: #F7F4EE !important;
    color: #1C1A17 !important;
  }
  
  :global(body header) {
    background-color: rgba(247, 244, 238, 0.95) !important;
    border-color: rgba(28, 26, 23, 0.1) !important;
  }

  :global(body nav a), :global(body .nav-item) {
    color: #1C1A17 !important;
  }
  
  :global(body nav a:hover), :global(body .nav-item:hover) {
    color: #8B2020 !important;
  }
</style>
