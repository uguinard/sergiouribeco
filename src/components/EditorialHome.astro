---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    mastheadTitle: "SERGIO URIBE GUINARD",
    mastheadSubtitle: "PORTFOLIO & FIELDWORK",
    issueInfo: "Issue No. 02 — Autumn / Winter 2026",
    priceText: "DECENTRALIZED PEDAGOGY",
    
    // Article 1: Widescreen Video Still
    videoHeadline: "An Inquiry Into Voice",
    videoSub: "A video introduction to language, landscape, and restorative teaching.",
    videoLabel: "FEATURE STILL — SCRATCHPAD & FIELD NOTES",
    
    // Article 2: The Restorative Classroom
    article2Title: "I. The Architecture of Ubuntu",
    article2Author: "On Restorative Circles & Relational Teaching",
    article2Body1: "R",
    article2Body1Text: "elationships must precede rules. In the design of the modern classroom, we often prioritize systemic structures over somatic realities. By centering Ubuntu—the realization that we only exist through our connections with others—we shift the pedagogical focus from compliance to collaboration. Restorative circles, rather than punitive boundaries, co-create the emotional framework necessary for true language acquisition.",
    article2Body2: "Language is not a collection of lexical units to be cataloged, but an environment to be inhabited. Following 4E Cognition (Embodied, Embedded, Enacted, Extended), we recognize that learning is physical. When we scaffold Spanish or EAL, we must activate the body, respect the local space, and treat the surrounding environment as a conversational partner.",

    // Article 3: The Maker Mindset
    article3Title: "II. Code as Craftsman’s Tool",
    article3Subtitle: "Custom digital tools for multilingual classrooms.",
    article3Body: "In an era of mass-produced educational materials, the educator must reclaim the role of the maker. I build my own interactive pipelines. Leveraging Python, custom H5P modules, and tailored LLM agents, I design materials that adapt to the precise cognitive space of the learner rather than forcing them into pre-packaged templates.",

    // Article 4: The Beginner's Mind
    article4Title: "III. The Andes & The Amazon",
    article4Subtitle: "Notes on decentering pedagogical authority.",
    article4Body: "Cycling 1,200 kilometers from Colombia to Ecuador teaches a profound humility. There is no support vehicle; there is only the rhythm of the road and the kindness of strangers. This beginner's mind is carried directly into the classroom. In the Amazonian watershed, teaching becomes a process of unlearning—decentering academic authority to center the quiet wisdom of student inquiry and the profound lessons of silence.",

    // CTA
    ctaText: "Read the Curriculum Vitae ➔",
    pdfText: "Download Printed Dossier (PDF) ⬇"
  },
  es: {
    mastheadTitle: "SERGIO URIBE GUINARD",
    mastheadSubtitle: "PORTAFOLIO Y TRABAJO DE CAMPO",
    issueInfo: "Edición No. 02 — Otoño / Invierno 2026",
    priceText: "PEDAGOGÍA DESCENTRALIZADA",
    
    // Article 1: Widescreen Video Still
    videoHeadline: "Una Indagación sobre la Voz",
    videoSub: "Una introducción en video al lenguaje, el territorio y la enseñanza restaurativa.",
    videoLabel: "FOTOGRAMA CLAVE — NOTAS DE CAMPO",
    
    // Article 2: The Restorative Classroom
    article2Title: "I. La Arquitectura de Ubuntu",
    article2Author: "Sobre círculos restaurativos y enseñanza relacional",
    article2Body1: "L",
    article2Body1Text: "as relaciones deben preceder a las normas. En el diseño del aula moderna, a menudo priorizamos las estructuras sobre las realidades somáticas. Al centrar Ubuntu —la certeza de que solo existimos a través de nuestras conexiones— transformamos la enseñanza. Los círculos restaurativos, en lugar de los límites punitivos, cocrean la arquitectura emocional indispensable para la adquisición del lenguaje.",
    article2Body2: "El lenguaje no es una colección de unidades léxicas para catalogar, sino un mundo a habitar. Siguiendo la Cognición 4E (Corporizada, Embebida, Ejecutada, Extendida), reconocemos que el aprendizaje es físico. Al diseñar el andamiaje para español o EAL, debemos activar el cuerpo y respetar el entorno como interlocutor activo.",

    // Article 3: The Maker Mindset
    article3Title: "II. El Código como Herramienta",
    article3Subtitle: "Herramientas digitales a la medida del aula multilingüe.",
    article3Body: "En una época de recursos educativos genéricos, el educador debe recuperar el rol de creador. Construyo mis propios pipelines. Utilizando Python, módulos H5P personalizados y agentes de IA específicos, diseño materiales que respetan la arquitectura cognitiva del estudiante en lugar de forzarlo a plantillas predefinidas.",

    // Article 4: The Beginner's Mind
    article4Title: "III. Los Andes y el Amazonas",
    article4Subtitle: "Notas sobre la descentralización de la autoridad pedagógica.",
    article4Body: "Recorrer 1,200 kilómetros en bicicleta desde Colombia hasta Ecuador enseña una profunda humildad. No hay vehículo de apoyo; solo el ritmo de la ruta y la hospitalidad de los desconocidos. Llevo esta mente de principiante al aula. En la Amazonía, enseñar se convierte en un acto de desaprendizaje: descentralizar la autoridad académica para escuchar la sabiduría de la indagación del estudiante y el silencio.",

    // CTA
    ctaText: "Ver Currículum Vitae ➔",
    pdfText: "Descargar Dossier Impreso (PDF) ⬇"
  }
};

const t = content[lang] || content.en;
---

<div class="editorial-home max-w-5xl mx-auto px-4 md:px-8 py-12">
  
  <!-- Masthead (Printed Journal Cover Header) -->
  <header class="border-b-4 border-[#1C1A17] pb-8 mb-12 text-center md:text-left">
    <div class="flex flex-col md:flex-row justify-between items-center md:items-end gap-4">
      <div>
        <span class="font-sans font-bold text-[11px] tracking-[0.4em] uppercase text-[#8B2020] block mb-2">
          {t.mastheadSubtitle}
        </span>
        <h1 class="font-serif text-4xl md:text-6xl font-normal tracking-tight text-[#1C1A17] leading-none">
          {t.mastheadTitle}
        </h1>
      </div>
      <div class="text-center md:text-right font-sans text-[10px] tracking-widest uppercase text-[#1C1A17]/60">
        <div class="font-bold text-[#1C1A17]">{t.issueInfo}</div>
        <div>{t.priceText}</div>
      </div>
    </div>
  </header>

  <!-- Feature Film Still Section (Intro Video) -->
  <section class="mb-16">
    <div class="border border-[#1C1A17]/10 p-2 bg-[#F7F4EE] shadow-sm">
      <!-- Letterboxed Aspect Video Container (Cinematic Film Still Feeling) -->
      <div class="relative w-full aspect-[21/9] rounded bg-[#1C1A17] overflow-hidden border-b-8 border-t-8 border-[#1C1A17] shadow-inner group">
        <iframe 
          class="absolute inset-0 w-full h-full opacity-90 group-hover:opacity-100 transition-opacity duration-500"
          src="https://www.youtube.com/embed/AusbshtWUnE" 
          title="Sergio Uribe Guinard - Film Still Intro" 
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
          referrerpolicy="strict-origin-when-cross-origin" 
          allowfullscreen
        ></iframe>
      </div>
    </div>
    <div class="mt-4 flex flex-col md:flex-row justify-between items-start gap-4 border-b border-[#1C1A17]/10 pb-6">
      <div>
        <span class="font-mono text-[9px] tracking-widest text-[#8B2020] block uppercase mb-1">
          {t.videoLabel}
        </span>
        <h2 class="font-serif text-2xl text-[#1C1A17] font-normal leading-tight">
          {t.videoHeadline}
        </h2>
      </div>
      <p class="font-serif italic text-xs text-[#1C1A17]/70 max-w-md">
        {t.videoSub}
      </p>
    </div>
  </section>

  <!-- Long-Form Articles Layout (Newspaper Columns style) -->
  <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
    
    <!-- Left Article (Spans 7 columns) -->
    <article class="lg:col-span-7 border-b lg:border-b-0 pb-12 lg:pb-0 border-[#1C1A17]/10">
      <h3 class="font-serif text-3xl font-normal text-[#1C1A17] mb-2 leading-tight">
        {t.article2Title}
      </h3>
      <h4 class="font-sans font-bold text-[10px] tracking-[0.2em] text-[#8B2020] uppercase mb-8">
        {t.article2Author}
      </h4>
      
      <!-- Columns layout for printed journal look -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-[#1C1A17] font-serif text-sm leading-relaxed text-justify">
        <div>
          <p class="mb-4">
            <span class="float-left text-5xl font-serif text-[#8B2020] leading-[0.8] mt-1 mr-2 font-normal">
              {t.article2Body1}
            </span>
            {t.article2Body1Text}
          </p>
        </div>
        <div>
          <p class="mb-4">
            {t.article2Body2}
          </p>
          <div class="h-[1px] w-16 bg-[#8B2020]/30 my-6"></div>
          <span class="font-sans text-[9px] tracking-widest text-[#1C1A17]/50 uppercase block">
            [ METAPHOR & RESTORATION ]
          </span>
        </div>
      </div>
    </article>

    <!-- Right Sidebar Articles (Spans 5 columns) -->
    <aside class="lg:col-span-5 flex flex-col gap-12 lg:border-l lg:border-[#1C1A17]/15 lg:pl-10">
      
      <!-- Article 3: Tech -->
      <div class="border-b border-[#1C1A17]/10 pb-8">
        <span class="font-mono text-[9px] tracking-widest text-[#8B2020] uppercase block mb-2">[ ARTICLE II / CRAFT ]</span>
        <h3 class="font-serif text-xl font-normal text-[#1C1A17] mb-2">
          {t.article3Title}
        </h3>
        <p class="font-serif italic text-xs text-[#1C1A17]/60 mb-4">{t.article3Subtitle}</p>
        <p class="font-serif text-xs text-[#1C1A17] leading-relaxed text-justify">
          {t.article3Body}
        </p>
      </div>

      <!-- Article 4: Roots -->
      <div>
        <span class="font-mono text-[9px] tracking-widest text-[#8B2020] uppercase block mb-2">[ ARTICLE III / UNLEARNING ]</span>
        <h3 class="font-serif text-xl font-normal text-[#1C1A17] mb-2">
          {t.article4Title}
        </h3>
        <p class="font-serif italic text-xs text-[#1C1A17]/60 mb-4">{t.article4Subtitle}</p>
        <p class="font-serif text-xs text-[#1C1A17] leading-relaxed text-justify">
          {t.article4Body}
        </p>
      </div>

    </aside>

  </section>

  <!-- Editorial Footnotes & CTA Footer -->
  <footer class="border-t border-[#1C1A17] pt-8 flex flex-col md:flex-row justify-between items-center gap-6">
    <span class="font-mono text-[9px] tracking-widest text-[#1C1A17]/40 uppercase">
      © 2026 S.U.G. — PRINTED VIA ASTRO
    </span>
    
    <div class="flex flex-col sm:flex-row gap-4 items-center">
      <!-- Read CV -->
      <a 
        href={`/${lang === 'en' ? '' : lang + '/'}cv`}
        class="font-sans font-bold text-xs tracking-widest text-[#1C1A17] hover:text-[#8B2020] uppercase transition-colors duration-300"
      >
        {t.ctaText}
      </a>
      
      <span class="hidden sm:inline text-[#1C1A17]/20">|</span>
      
      <!-- Download credentials -->
      <a 
        href="/cv"
        class="font-sans font-bold text-xs tracking-widest text-[#8B2020] hover:text-[#1C1A17] uppercase transition-colors duration-300"
      >
        {t.pdfText}
      </a>
    </div>
  </footer>
</div>

<style>
  /* Literary layout global overrides & helper classes */
  .editorial-home {
    background-color: #F7F4EE;
    color: #1C1A17;
  }

  /* Support Earthy Mode styles overrides if needed */
  :global(body) {
    background-color: #F7F4EE !important;
    color: #1C1A17 !important;
  }
  
  :global(body header) {
    background-color: rgba(247, 244, 238, 0.95) !important;
    border-color: rgba(28, 26, 23, 0.1) !important;
  }

  :global(body nav a), :global(body .nav-item) {
    color: #1C1A17 !important;
  }
  
  :global(body nav a:hover), :global(body .nav-item:hover) {
    color: #8B2020 !important;
  }

  :global(body footer) {
    border-color: rgba(28, 26, 23, 0.2) !important;
    color: #1C1A17/60 !important;
  }
</style>
