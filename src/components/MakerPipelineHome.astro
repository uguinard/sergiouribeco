---
interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'en' } = Astro.props;

const content = {
  en: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "System Diagram — Pedagogical & Technical Flow",
    engineLabel: "ENGINE ROOM / CENTRAL CAPTURE",
    engineDesc: "The core narrative driving this system.",
    
    // Stages
    stage1Label: "NODE_01 // FOUNDATION",
    stage1Title: "Academic & Cognitive Input",
    stage1Brief: "IB Certification & 4E Cognition Frameworks.",
    stage1Detail: "Master's in Spanish ELE. Trained in 4E Cognition (Embodied, Embedded, Enacted, Extended) and Conceptual Metaphor Theory. Designing language acquisition scaffolding that respects cognitive loads and structures.",

    stage2Label: "NODE_02 // COMPILATION",
    stage2Title: "EdTech & Custom Pipelines",
    stage2Brief: "Python scripts, Astro frontends, and H5P modules.",
    stage2Detail: "Rather than using mass-market educational materials, I code interactive tools tailored specifically for the multilingual students in my care. Active developer of custom digital resources.",

    stage3Label: "NODE_03 // DISCHARGE",
    stage3Title: "Holistic & Relational Impact",
    stage3Brief: "Restorative practices & pastoral circles.",
    stage3Detail: "Implementing Ubuntu philosophy in classroom ecosystems. Focusing on somatic emotional support, restorative justice circles, and human-to-human connections as the baseline for learning.",
    
    cvLink: "Open Dossier (CV) ➔",
    pdfLink: "Download Print Version (PDF) ⬇"
  },
  es: {
    title: "SERGIO URIBE GUINARD",
    subtitle: "Diagrama del Sistema — Flujo Técnico y Pedagógico",
    engineLabel: "CUARTO DE MÁQUINAS / CAPTURA CENTRAL",
    engineDesc: "La narrativa central que impulsa el sistema.",
    
    // Stages
    stage1Label: "NODO_01 // FUNDACIÓN",
    stage1Title: "Input Académico y Cognitivo",
    stage1Brief: "Certificación IB y marcos de Cognición 4E.",
    stage1Detail: "Máster en ELE. Especializado en Cognición 4E (Corporizada, Embebida, Ejecutada, Extendida) y Teoría de la Metáfora Conceptual. Diseño de andamiaje para la adquisición del lenguaje.",

    stage2Label: "NODO_02 // COMPILACIÓN",
    stage2Title: "EdTech y Pipelines a Medida",
    stage2Brief: "Scripts en Python, frontends en Astro y H5P.",
    stage2Detail: "En lugar de depender de recursos comerciales genéricos, programo herramientas interactivas a la medida de los estudiantes multilingües. Desarrollador activo de pipelines educativos digitales.",

    stage3Label: "NODO_03 // DESCARGA",
    stage3Title: "Impacto Holístico y Relacional",
    stage3Brief: "Prácticas restaurativas y círculos de apoyo.",
    stage3Detail: "Implementación de la filosofía Ubuntu en el aula. Soporte socioemocional somático, círculos restaurativos y conexión humana como base del aprendizaje.",
    
    cvLink: "Ver Currículum (CV) ➔",
    pdfLink: "Descargar Versión Impresa (PDF) ⬇"
  }
};

const t = content[lang] || content.en;
---

<div 
  class="maker-pipeline-container max-w-5xl mx-auto px-6 py-12 text-[#1C1A17] bg-[#F7F4EE] font-mono text-xs"
  x-data="{ 
    selectedNode: 1
  }"
>
  
  <!-- System Header -->
  <header class="border-b border-[#1C1A17]/25 pb-6 mb-12">
    <span class="text-[#8B2020] font-bold block mb-1">SYSTEM_STATUS: ACTIVE</span>
    <h1 class="font-serif text-3xl md:text-5xl font-normal text-[#1C1A17] tracking-tight leading-none mb-2">
      {t.title}
    </h1>
    <p class="text-[#1C1A17]/60">
      {t.subtitle}
    </p>
  </header>

  <!-- Main Grid: Flow Engine & Interactive Nodes -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start mb-16">
    
    <!-- Left: Flow Diagram & Nodes (Spans 6 columns) -->
    <div class="lg:col-span-6 flex flex-col gap-6">
      
      <!-- Interactive SVG Flow Line -->
      <div class="relative flex flex-col gap-8 pl-8 border-l border-dashed border-[#1C1A17]/30 py-4">
        
        <!-- Node 1 -->
        <div 
          @click="selectedNode = 1"
          class="relative cursor-pointer group transition-all duration-300 p-4 rounded border border-[#1C1A17]/10"
          :class="selectedNode === 1 ? 'border-[#8B2020] bg-[#8B2020]/5 shadow-inner' : 'bg-transparent hover:border-[#1C1A17]/30'"
        >
          <!-- Absolute node dot indicator -->
          <div 
            class="absolute -left-[37px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-[#1C1A17] bg-[#F7F4EE] flex items-center justify-center transition-all duration-300"
            :class="selectedNode === 1 ? 'border-[#8B2020] bg-[#8B2020]' : ''"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-transparent" :class="selectedNode === 1 ? 'bg-[#F7F4EE]' : ''"></span>
          </div>

          <span class="text-[9px] tracking-widest text-[#8B2020] block font-bold mb-1">
            {t.stage1Label}
          </span>
          <h3 class="font-serif text-base text-[#1C1A17] font-normal mb-1">
            {t.stage1Title}
          </h3>
          <p class="text-[#1C1A17]/60 text-[10px]">
            {t.stage1Brief}
          </p>
        </div>

        <!-- Node 2 -->
        <div 
          @click="selectedNode = 2"
          class="relative cursor-pointer group transition-all duration-300 p-4 rounded border border-[#1C1A17]/10"
          :class="selectedNode === 2 ? 'border-[#8B2020] bg-[#8B2020]/5 shadow-inner' : 'bg-transparent hover:border-[#1C1A17]/30'"
        >
          <!-- Absolute node dot indicator -->
          <div 
            class="absolute -left-[37px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-[#1C1A17] bg-[#F7F4EE] flex items-center justify-center transition-all duration-300"
            :class="selectedNode === 2 ? 'border-[#8B2020] bg-[#8B2020]' : ''"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-transparent" :class="selectedNode === 2 ? 'bg-[#F7F4EE]' : ''"></span>
          </div>

          <span class="text-[9px] tracking-widest text-[#8B2020] block font-bold mb-1">
            {t.stage2Label}
          </span>
          <h3 class="font-serif text-base text-[#1C1A17] font-normal mb-1">
            {t.stage2Title}
          </h3>
          <p class="text-[#1C1A17]/60 text-[10px]">
            {t.stage2Brief}
          </p>
        </div>

        <!-- Node 3 -->
        <div 
          @click="selectedNode = 3"
          class="relative cursor-pointer group transition-all duration-300 p-4 rounded border border-[#1C1A17]/10"
          :class="selectedNode === 3 ? 'border-[#8B2020] bg-[#8B2020]/5 shadow-inner' : 'bg-transparent hover:border-[#1C1A17]/30'"
        >
          <!-- Absolute node dot indicator -->
          <div 
            class="absolute -left-[37px] top-1/2 -translate-y-1/2 w-4 h-4 rounded-full border-2 border-[#1C1A17] bg-[#F7F4EE] flex items-center justify-center transition-all duration-300"
            :class="selectedNode === 3 ? 'border-[#8B2020] bg-[#8B2020]' : ''"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-transparent" :class="selectedNode === 3 ? 'bg-[#F7F4EE]' : ''"></span>
          </div>

          <span class="text-[9px] tracking-widest text-[#8B2020] block font-bold mb-1">
            {t.stage3Label}
          </span>
          <h3 class="font-serif text-base text-[#1C1A17] font-normal mb-1">
            {t.stage3Title}
          </h3>
          <p class="text-[#1C1A17]/60 text-[10px]">
            {t.stage3Brief}
          </p>
        </div>

      </div>

    </div>

    <!-- Right: Central Engine Video & Expanded Data Inspector (Spans 6 columns) -->
    <div class="lg:col-span-6 flex flex-col gap-6">
      
      <!-- Video "Engine" Container -->
      <div class="border border-[#1C1A17]/15 p-4 rounded bg-[#F7F4EE] shadow-sm relative overflow-hidden">
        <span class="text-[9px] tracking-widest text-[#8B2020] font-bold block mb-2">
          {t.engineLabel}
        </span>
        <div class="relative w-full aspect-video rounded overflow-hidden bg-black border border-[#1C1A17]/25 shadow-inner">
          <iframe 
            class="absolute inset-0 w-full h-full"
            src="https://www.youtube.com/embed/AusbshtWUnE" 
            title="Sergio Uribe Guinard - Central Engine" 
            frameborder="0" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
            referrerpolicy="strict-origin-when-cross-origin" 
            allowfullscreen
          ></iframe>
        </div>
        <p class="font-serif italic text-[#1C1A17]/60 mt-2 text-[10px]">
          {t.engineDesc}
        </p>
      </div>

      <!-- Node Inspector Panel -->
      <div class="border border-[#8B2020]/25 rounded p-5 bg-[#8B2020]/5 shadow-sm min-h-[160px] flex flex-col justify-between transition-all duration-300">
        <div>
          <span class="text-[9px] tracking-widest text-[#8B2020] font-bold block mb-2 uppercase">
            // TERMINAL_INSPECTOR: NODE_0<span x-text="selectedNode"></span>
          </span>
          
          <!-- Node 1 Detail -->
          <div x-show="selectedNode === 1" class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/85">
            {t.stage1Detail}
          </div>

          <!-- Node 2 Detail -->
          <div x-show="selectedNode === 2" class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/85" style="display:none;">
            {t.stage2Detail}
          </div>

          <!-- Node 3 Detail -->
          <div x-show="selectedNode === 3" class="font-serif text-xs leading-relaxed text-justify text-[#1C1A17]/85" style="display:none;">
            {t.stage3Detail}
          </div>
        </div>

        <div class="mt-4 pt-3 border-t border-[#1C1A17]/10 flex justify-between text-[10px] text-[#1C1A17]/50">
          <span>PIPELINE_STATUS: VALIDATED</span>
          <span>VAL: 0x8B2020</span>
        </div>
      </div>

    </div>

  </div>

  <!-- Footer Actions -->
  <footer class="border-t border-[#1C1A17]/20 pt-8 flex justify-between items-center text-[10px]">
    <a 
      href={`/${lang === 'en' ? '' : lang + '/'}cv`}
      class="font-bold tracking-widest text-[#1C1A17] hover:text-[#8B2020] uppercase transition-colors"
    >
      {t.cvLink}
    </a>
    
    <a 
      href="/cv"
      class="font-bold tracking-widest text-[#8B2020] hover:text-[#1C1A17] uppercase transition-colors"
    >
      {t.pdfLink}
    </a>
  </footer>
</div>

<style>
  /* Base design system overrides */
  :global(body) {
    background-color: #F7F4EE !important;
    color: #1C1A17 !important;
  }
  
  :global(body header) {
    background-color: rgba(247, 244, 238, 0.95) !important;
    border-color: rgba(28, 26, 23, 0.1) !important;
  }

  :global(body nav a), :global(body .nav-item) {
    color: #1C1A17 !important;
  }
  
  :global(body nav a:hover), :global(body .nav-item:hover) {
    color: #8B2020 !important;
  }
</style>
